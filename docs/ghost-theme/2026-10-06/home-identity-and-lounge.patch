me-lounge p{font-size:18px;line-height:1.6;margin:0 0 20px}.pl-home-lounge .pl-lounge-eyebrow{opacity:.75;margin-bottom:12px}.pl-lounge-questions{font-weight:650}.pl-articles-heading{display:flex;align-items:baseline;justify-content:space-between;gap:16px;flex-wrap:wrap;margin:0 0 24px}.pl-articles-heading h2{font-size:28px;margin:0}.pl-articles-heading a{font-size:16px;color:var(--primary-foreground-color);text-decoration:underline;text-underline-offset:4px}.pl-home-en .l-content{padding-top:40px}.pl-home-en .l-grid{margin-bottom:24px}@media(max-width:600px){.pl-home-hero{padding:94px 22px 38px;min-height:0;background-position:62% center}.pl-home-hero:before{background:rgba(8,13,20,.84)}.pl-home-copy{margin:0}.pl-home-description{font-size:16px}.pl-home-route{font-size:14px}.pl-home-actions{flex-direction:column}.pl-home-button{width:100%}.pl-home-lounge{padding:24px 22px;margin-bottom:30px}.pl-home-lounge p{font-size:16px}.pl-articles-heading h2{font-size:24px}}
