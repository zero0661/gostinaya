[Unit]
Description=After Login encrypted backup
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/gostinaya
ExecStart=/usr/bin/python3 /usr/local/lib/after-login-backup-daily.py
TimeoutStartSec=30min
UMask=0077
Nice=10
IOSchedulingClass=idle
