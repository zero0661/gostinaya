<section class="profile-page member-profile-page">

  <header class="profile-header member-profile-header">
    <p class="profile-eyebrow">
      Гостиная <span>/ The Lounge</span>
    </p>

    <h1><%= member.name %></h1>

    <p>
      <%= member.bio || 'Пока участник ничего о себе не рассказал.' %>
      <% if (!member.bio) { %>
        <br><span>This member has not shared anything about themselves yet.</span>
      <% } %>
    </p>
  </header>

  <section class="profile-card member-profile-meta">
    <div class="topic-meta">
      <span>👤 <%= member.role %></span>
      <span>🌍 <%= member.language %></span>

      <% if (member.location) { %>
        <span>📍 <%= member.location %></span>
      <% } %>

      <span>📝 <%= member.topics_count %> тем</span>
      <span>💬 <%= member.messages_count %> сообщений</span>
      <span>📅 <%= formatMoscowDateTime(member.created_at) %></span>
    </div>
  </section>

  <section class="profile-card member-profile-section">
    <h2>
      Последние темы <span>/ Recent Topics</span>
    </h2>

    <% if (!topics.length) { %>
      <div class="room-empty">
        <p>
          Тем пока нет.
          <span>No topics yet.</span>
        </p>
      </div>
    <% } else { %>
      <div class="topic-list">
        <% topics.forEach(topic => { %>
          <a class="topic-card-link" href="/gostinaya/topic/<%= topic.id %>">
            <article class="topic-item topic-card">
              <h3><%= topic.title %></h3>

              <div class="topic-meta">
                <span>📅 <%= formatMoscowDateTime(topic.created_at) %></span>
              </div>
            </article>
          </a>
        <% }) %>
      </div>
    <% } %>
  </section>

  <section class="profile-card member-profile-section">
    <h2>
      Последние сообщения <span>/ Recent Messages</span>
    </h2>

    <% if (!messages.length) { %>
      <div class="room-empty">
        <p>
          Сообщений пока нет.
          <span>No messages yet.</span>
        </p>
      </div>
    <% } else { %>
      <div class="topic-list">
        <% messages.forEach(message => { %>
          <a class="topic-card-link" href="/gostinaya/topic/<%= message.topic_id %>">
            <article class="topic-item topic-card">
              <h3><%= message.title %></h3>

              <p class="topic-preview"><%- linkifyText(message.body) %></p>

              <div class="topic-meta">
                <span>📅 <%= formatMoscowDateTime(message.created_at) %></span>
              </div>
            </article>
          </a>
        <% }) %>
      </div>
    <% } %>
  </section>

  <nav class="members-navigation">
    <a href="/gostinaya/members">
      ← Все участники / <span>All Members</span>
    </a>
  </nav>

</section>
