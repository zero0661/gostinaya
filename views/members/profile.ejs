<section class="profile-page member-profile-page">
  <header class="profile-header member-profile-header">
    <p class="profile-eyebrow"><span data-lang="ru">Гостиная</span><span data-lang="en">The Lounge</span></p>
    <h1><%= member.name %></h1>
    <p>
      <% if (member.bio) { %>
        <%= member.bio %>
      <% } else { %>
        <span data-lang="ru">Пока участник ничего о себе не рассказал.</span>
        <span data-lang="en">This member has not shared anything about themselves yet.</span>
      <% } %>
    </p>
  </header>

  <section class="profile-card member-profile-meta">
    <div class="topic-meta">
      <span>👤 <%= member.role %></span>
      <span>🌍 <%= member.language %></span>
      <% if (member.location) { %><span>📍 <%= member.location %></span><% } %>
      <span data-lang="ru">📝 <%= member.topics_count %> тем</span>
      <span data-lang="en">📝 <%= member.topics_count %> topics</span>
      <span data-lang="ru">💬 <%= member.messages_count %> сообщений</span>
      <span data-lang="en">💬 <%= member.messages_count %> messages</span>
      <span>📅 <%= formatMoscowDateTime(member.created_at) %></span>
    </div>
  </section>

  <section class="profile-card member-profile-section">
    <h2><span data-lang="ru">Последние темы</span><span data-lang="en">Recent Topics</span></h2>
    <% if (!topics.length) { %>
      <div class="room-empty"><p><span data-lang="ru">Тем пока нет.</span><span data-lang="en">No topics yet.</span></p></div>
    <% } else { %>
      <div class="topic-list">
        <% topics.forEach(topic => { %>
          <a class="topic-card-link" href="/gostinaya/topic/<%= topic.id %>">
            <article class="topic-item topic-card">
              <h3><%= topic.title %></h3>
              <div class="topic-meta"><span>📅 <%= formatMoscowDateTime(topic.created_at) %></span></div>
            </article>
          </a>
        <% }) %>
      </div>
    <% } %>
  </section>

  <section class="profile-card member-profile-section">
    <h2><span data-lang="ru">Последние сообщения</span><span data-lang="en">Recent Messages</span></h2>
    <% if (!messages.length) { %>
      <div class="room-empty"><p><span data-lang="ru">Сообщений пока нет.</span><span data-lang="en">No messages yet.</span></p></div>
    <% } else { %>
      <div class="topic-list">
        <% messages.forEach(message => { %>
          <a class="topic-card-link" href="/gostinaya/topic/<%= message.topic_id %>">
            <article class="topic-item topic-card">
              <h3><%= message.title %></h3>
              <p class="topic-preview"><%- linkifyText(message.body) %></p>
              <div class="topic-meta"><span>📅 <%= formatMoscowDateTime(message.created_at) %></span></div>
            </article>
          </a>
        <% }) %>
      </div>
    <% } %>
  </section>

  <nav class="members-navigation">
    <a href="/gostinaya/members"><span data-lang="ru">← Все участники</span><span data-lang="en">← All Members</span></a>
  </nav>
</section>
