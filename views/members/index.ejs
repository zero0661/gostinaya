<section class="profile-page members-page">

  <header class="profile-header lounge-page-header">
    <p class="profile-eyebrow">
      Гостиная <span>/ The Lounge</span>
    </p>

    <h1>
      Участники <span>/ Members</span>
    </h1>

    <p>
      Люди, которые уже присоединились к проекту.
      <span>People who have already joined the project.</span>
    </p>
  </header>

  <section class="profile-card members-panel">

    <div class="members-panel-header">
      <div>
        <h2>
          Сообщество <span>/ Community</span>
        </h2>

        <p>
          Все зарегистрированные участники.
          <span>All registered members.</span>
        </p>
      </div>
    </div>

    <% if (!members.length) { %>

      <div class="members-empty">
        <h3>Пока никого</h3>
        <p>
          Вы будете первым участником.
          <span>You will be the first member.</span>
        </p>
      </div>

    <% } else { %>

      <div class="members-grid">

        <% members.forEach(member => { %>

          <article class="member-card">

            <h3>
              <a href="/gostinaya/member/<%= member.id %>">
                <%= member.name %>
              </a>
            </h3>

            <p class="member-bio">
              <%= member.bio || 'Пока без описания.' %>
            </p>

            <div class="member-meta">
              <span>👤 <%= member.role %></span>
              <span>🌍 <%= member.language %></span>

              <% if (member.location) { %>
                <span>📍 <%= member.location %></span>
              <% } %>

              <span>💬 <%= member.messages_count %></span>
              <span>📝 <%= member.topics_count %></span>
            </div>

          </article>

        <% }) %>

      </div>

    <% } %>

  </section>

  <nav class="members-navigation">
    <a href="/gostinaya/hall">← Вернуться в Холл</a>
  </nav>

</section>
