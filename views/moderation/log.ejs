<section class="profile-page moderation-page">
  <% const actionLabels = {
    account_blocked: 'Заблокирован аккаунт', account_unblocked: 'Разблокирован аккаунт', account_role_changed: 'Изменена роль',
    topic_pinned: 'Закреплена тема', topic_unpinned: 'Откреплена тема', topic_closed: 'Закрыта тема', topic_reopened: 'Открыта тема',
    topic_hidden: 'Скрыта тема', topic_restored: 'Восстановлена тема', message_hidden: 'Скрыто сообщение', message_restored: 'Восстановлено сообщение',
    report_resolved: 'Жалоба решена', report_dismissed: 'Жалоба отклонена'
  }; %>
  <% const targetLabels = { account: 'аккаунт', topic: 'тема', message: 'сообщение', report: 'жалоба' }; %>
  <header class="profile-header">
    <p class="profile-eyebrow"><a href="/gostinaya/moderation">Модерация</a></p>
    <h1>Журнал действий</h1>
    <p>История не редактируется через интерфейс.</p>
  </header>
  <section class="profile-card moderation-panel moderation-log-list">
    <% actions.forEach(item => { %>
      <article>
        <strong><%= item.actor_name %></strong>
        <span><%= actionLabels[item.action] || item.action %> · <%= targetLabels[item.target_type] || item.target_type %> №<%= item.target_id %></span>
        <small><%= formatMoscowDateTime(item.created_at) %><%= item.details ? ` · ${item.details}` : '' %></small>
      </article>
    <% }) %>
    <% if (!actions.length) { %><p>Журнал пуст.</p><% } %>
  </section>
</section>
