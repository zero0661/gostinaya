<section class="profile-page moderation-page">
  <header class="profile-header">
    <p class="profile-eyebrow"><a href="/gostinaya/moderation/discussions">← Обсуждения</a></p>
    <h1><%= topic.title %></h1>
    <p>
      №<%= topic.id %> ·
      <%= topic.room === 'articles'
        ? 'Обсуждение статьи · создано автоматически'
        : topic.room === 'news'
          ? `Новость проекта · Автор: ${topic.author}`
          : `Тема сообщества · Автор: ${topic.author}` %>
    </p>
  </header>

  <section class="profile-card moderation-panel">
    <h2>Управление темой</h2>
    <div class="moderation-button-row">
      <form method="post" action="/gostinaya/moderation/topics/<%= topic.id %>/<%= topic.pinned ? 'unpin' : 'pin' %>">
        <button type="submit"><%= topic.pinned ? 'Открепить' : 'Закрепить' %></button>
      </form>
      <form method="post" action="/gostinaya/moderation/topics/<%= topic.id %>/<%= topic.closed ? 'reopen' : 'close' %>">
        <button type="submit"><%= topic.closed ? 'Открыть' : 'Закрыть' %></button>
      </form>
      <% if (topic.hidden_at) { %>
        <form method="post" action="/gostinaya/moderation/topics/<%= topic.id %>/restore">
          <button type="submit">Восстановить</button>
        </form>
      <% } else { %>
        <form class="moderation-hide-action" method="post" action="/gostinaya/moderation/topics/<%= topic.id %>/hide">
          <input name="reason" maxlength="500" placeholder="Причина скрытия" required>
          <button class="danger" type="submit">Скрыть</button>
        </form>
      <% } %>
    </div>
    <% if (topic.hidden_at) { %><p class="moderation-warning">Скрыта: <%= topic.hidden_reason %></p><% } %>
  </section>

  <section class="profile-card moderation-panel">
    <h2>Сообщения</h2>
    <div class="moderation-message-list">
      <% messages.forEach(message => { %>
        <article class="moderation-message <%= message.hidden_at ? 'is-danger' : '' %>">
          <header><strong>#<%= message.id %> · <%= message.author %></strong><span><%= formatMoscowDateTime(message.created_at) %></span></header>
          <p><%- linkifyText(message.body) %></p>
          <% if (message.hidden_at) { %>
            <p class="moderation-warning">Скрыто: <%= message.hidden_reason %></p>
            <form class="moderation-message-restore" method="post" action="/gostinaya/moderation/messages/<%= message.id %>/restore">
              <button type="submit">Восстановить</button>
            </form>
          <% } else { %>
            <form class="moderation-message-action" method="post" action="/gostinaya/moderation/messages/<%= message.id %>/hide">
              <input name="reason" maxlength="500" placeholder="Причина скрытия" required>
              <button class="danger" type="submit">Скрыть</button>
            </form>
          <% } %>
        </article>
      <% }) %>
    </div>
  </section>
</section>
