<section class="profile-page moderation-page">
  <header class="profile-header">
    <p class="profile-eyebrow"><a href="/gostinaya/moderation/discussions">← Обсуждения / Discussions</a></p>
    <h1><%= topic.title %></h1>
    <p>#<%= topic.id %> · <%= topic.room %> · <%= topic.author %></p>
  </header>

  <section class="profile-card moderation-panel">
    <h2>Управление темой<br><span>Topic controls</span></h2>
    <div class="moderation-button-row">
      <form method="post" action="/gostinaya/moderation/topics/<%= topic.id %>/<%= topic.pinned ? 'unpin' : 'pin' %>">
        <button type="submit"><%= topic.pinned ? 'Открепить / Unpin' : 'Закрепить / Pin' %></button>
      </form>
      <form method="post" action="/gostinaya/moderation/topics/<%= topic.id %>/<%= topic.closed ? 'reopen' : 'close' %>">
        <button type="submit"><%= topic.closed ? 'Открыть / Reopen' : 'Закрыть / Close' %></button>
      </form>
      <% if (topic.hidden_at) { %>
        <form method="post" action="/gostinaya/moderation/topics/<%= topic.id %>/restore">
          <button type="submit">Восстановить / Restore</button>
        </form>
      <% } else { %>
        <form method="post" action="/gostinaya/moderation/topics/<%= topic.id %>/hide">
          <input name="reason" maxlength="500" placeholder="Причина скрытия / Reason" required>
          <button class="danger" type="submit">Скрыть / Hide</button>
        </form>
      <% } %>
    </div>
    <% if (topic.hidden_at) { %><p class="moderation-warning">Скрыта: <%= topic.hidden_reason %></p><% } %>
  </section>

  <section class="profile-card moderation-panel">
    <h2>Сообщения<br><span>Messages</span></h2>
    <div class="moderation-message-list">
      <% messages.forEach(message => { %>
        <article class="moderation-message <%= message.hidden_at ? 'is-danger' : '' %>">
          <header><strong>#<%= message.id %> · <%= message.author %></strong><span><%= message.created_at %></span></header>
          <p><%= message.body %></p>
          <% if (message.hidden_at) { %>
            <p class="moderation-warning">Скрыто: <%= message.hidden_reason %></p>
            <form method="post" action="/gostinaya/moderation/messages/<%= message.id %>/restore">
              <button type="submit">Восстановить / Restore</button>
            </form>
          <% } else { %>
            <form method="post" action="/gostinaya/moderation/messages/<%= message.id %>/hide">
              <input name="reason" maxlength="500" placeholder="Причина скрытия / Reason" required>
              <button class="danger" type="submit">Скрыть / Hide</button>
            </form>
          <% } %>
        </article>
      <% }) %>
    </div>
  </section>
</section>
