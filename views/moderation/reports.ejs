<section class="profile-page moderation-page">
  <% const statusLabels = { open: 'Открыта', resolved: 'Решена', dismissed: 'Отклонена' }; %>
  <header class="profile-header">
    <p class="profile-eyebrow"><a href="/gostinaya/moderation">Модерация</a></p>
    <h1>Жалобы</h1>
  </header>

  <nav class="moderation-tabs">
    <a href="?status=open">Открытые</a>
    <a href="?status=resolved">Решённые</a>
    <a href="?status=dismissed">Отклонённые</a>
    <a href="?status=all">Все</a>
  </nav>

  <div class="moderation-list">
    <% reports.forEach(report => { %>
      <article class="profile-card moderation-item <%= report.status === 'open' ? 'is-warning' : '' %>">
        <div>
          <h2>Жалоба №<%= report.id %> <span><%= statusLabels[report.status] || report.status %></span></h2>
          <p><strong>От:</strong> <%= report.reporter_name %></p>
          <p><strong>Тема:</strong> <a href="/gostinaya/moderation/discussions/<%= report.target_topic_id %>"><%= report.topic_title || '—' %></a></p>
          <% if (report.message_id) { %><p><strong>Сообщение #<%= report.message_id %>:</strong> <%= report.message_body %></p><% } %>
          <p class="moderation-warning"><%= report.reason %></p>
        </div>
        <% if (report.status === 'open') { %>
          <form class="moderation-resolution" method="post" action="/gostinaya/moderation/reports/<%= report.id %>/status">
            <input name="note" maxlength="500" placeholder="Примечание к решению">
            <button name="status" value="resolved" type="submit">Решено</button>
            <button name="status" value="dismissed" type="submit">Отклонить</button>
          </form>
        <% } %>
      </article>
    <% }) %>
    <% if (!reports.length) { %><p>Здесь пусто.</p><% } %>
  </div>
</section>
