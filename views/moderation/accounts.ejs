<section class="profile-page moderation-page">
  <% const roleLabelsRu = { guest: 'Участник', author: 'Соавтор', moderator: 'Модератор', admin: 'Администратор', system: 'Система', legacy: 'Служебный' }; %>
  <% const roleLabelsEn = { guest: 'Member', author: 'Co-author', moderator: 'Moderator', admin: 'Administrator', system: 'System', legacy: 'Service' }; %>

  <header class="profile-header">
    <p class="profile-eyebrow"><a href="/gostinaya/moderation"><span data-lang="ru">Модерация</span><span data-lang="en">Moderation</span></a></p>
    <h1><span data-lang="ru">Аккаунты</span><span data-lang="en">Accounts</span></h1>
    <p data-lang="ru">Здесь доступны служебные данные аккаунтов и ответы, которые участники дали при регистрации. Эти сведения видят только модераторы.</p>
    <p data-lang="en">This page contains account administration data and the answers members provided during registration. Only moderators can see this information.</p>
  </header>

  <form class="moderation-filter" method="get">
    <input type="search" name="q" value="<%= search %>" data-placeholder-ru="Имя или e-mail" data-placeholder-en="Name or e-mail" placeholder="Имя или e-mail">
    <button type="submit"><span data-lang="ru">Найти</span><span data-lang="en">Search</span></button>
  </form>

  <div class="moderation-list">
    <% accounts.forEach(account => { %>
      <article class="profile-card moderation-item <%= account.is_blocked ? 'is-danger' : '' %>">
        <div class="moderation-item-main">
          <h2><%= account.name %> <span>#<%= account.id %></span></h2>
          <p><%= account.email %></p>
          <p>
            <strong data-lang="ru"><%= roleLabelsRu[account.role] || account.role %></strong>
            <strong data-lang="en"><%= roleLabelsEn[account.role] || account.role %></strong>
            ·
            <span data-lang="ru"><%= account.email_verified_at ? 'e-mail подтверждён' : 'e-mail не подтверждён' %></span>
            <span data-lang="en"><%= account.email_verified_at ? 'e-mail verified' : 'e-mail not verified' %></span>
          </p>
          <p>
            <span data-lang="ru"><strong>Регистрация:</strong> <%= account.created_at %> · <strong>Язык:</strong> <%= account.language || '—' %></span>
            <span data-lang="en"><strong>Registered:</strong> <%= account.created_at %> · <strong>Language:</strong> <%= account.language || '—' %></span>
          </p>
          <p>
            <span data-lang="ru"><strong>Страна:</strong> <%= account.country || '—' %> · <strong>Город:</strong> <%= account.city || account.location || '—' %></span>
            <span data-lang="en"><strong>Country:</strong> <%= account.country || '—' %> · <strong>City:</strong> <%= account.city || account.location || '—' %></span>
          </p>

          <% if (account.join_reason || account.current_topic) { %>
            <div class="moderation-registration-answers">
              <h3><span data-lang="ru">Ответы при регистрации</span><span data-lang="en">Registration answers</span></h3>
              <p data-lang="ru"><strong>Почему вам интересен проект «После логина»?</strong><br><%= account.join_reason || 'Ответ не указан.' %></p>
              <p data-lang="en"><strong>Why are you interested in After Login?</strong><br><%= account.join_reason || 'No answer provided.' %></p>
              <p data-lang="ru"><strong>Что вас сейчас особенно занимает или о чём хотелось бы поговорить?</strong><br><%= account.current_topic || 'Ответ не указан.' %></p>
              <p data-lang="en"><strong>What is especially on your mind right now, or what would you like to discuss?</strong><br><%= account.current_topic || 'No answer provided.' %></p>
            </div>
          <% } else { %>
            <p><em data-lang="ru">Ответы регистрационной анкеты не указаны.</em><em data-lang="en">No registration questionnaire answers were provided.</em></p>
          <% } %>

          <% if (account.is_blocked) { %>
            <p class="moderation-warning"><span data-lang="ru">Заблокирован: <%= account.blocked_reason %></span><span data-lang="en">Blocked: <%= account.blocked_reason %></span></p>
          <% } %>
        </div>

        <% if (Number(account.id) !== Number(currentGuest.id)) { %>
          <div class="moderation-actions">
            <% if (account.is_blocked) { %>
              <form method="post" action="/gostinaya/moderation/accounts/<%= account.id %>/unblock">
                <button type="submit"><span data-lang="ru">Разблокировать</span><span data-lang="en">Unblock</span></button>
              </form>
            <% } else if (!['admin', 'moderator', 'system', 'legacy'].includes(account.role) || currentGuest.role === 'admin') { %>
              <form method="post" action="/gostinaya/moderation/accounts/<%= account.id %>/block">
                <input name="reason" maxlength="500" data-placeholder-ru="Причина" data-placeholder-en="Reason" placeholder="Причина" required>
                <button class="danger" type="submit"><span data-lang="ru">Заблокировать</span><span data-lang="en">Block</span></button>
              </form>
            <% } %>

            <% if (currentGuest.role === 'admin' && !['system', 'legacy'].includes(account.role)) { %>
              <form method="post" action="/gostinaya/moderation/accounts/<%= account.id %>/role">
                <select name="role">
                  <% assignableRoles.forEach(role => { %>
                    <option value="<%= role %>" <%= role === account.role ? 'selected' : '' %>><%= roleLabelsRu[role] || role %> / <%= roleLabelsEn[role] || role %></option>
                  <% }) %>
                </select>
                <button type="submit"><span data-lang="ru">Изменить роль</span><span data-lang="en">Change role</span></button>
              </form>
            <% } %>
          </div>
        <% } %>
      </article>
    <% }) %>
  </div>
</section>
