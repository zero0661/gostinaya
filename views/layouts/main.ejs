<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title><%= title %> — Гостиная / The Lounge</title>
<link rel="stylesheet" type="text/css" href="/gostinaya/public/gostinaya.css?v=20260815-1">
<link rel="stylesheet" type="text/css" href="/gostinaya/public/gostinaya-logo.css?v=20260822-1">
</head>

<body>

<header class="lounge-banner">
    <img
        class="lounge-banner-image"
        src="/gostinaya/public/lounge-banner-center.jpg"
        alt="Гостиная проекта После логина"
    >

    <div class="lounge-banner-title" aria-label="После логина — Гостиная">
        <img
            class="lounge-banner-brand-logo"
            src="/gostinaya/public/after-login-logo-transparent.png"
            alt="После логина / After Login"
        >
        <span class="lounge-banner-name">Гостиная</span>
        <small>The Lounge</small>
    </div>

    <blockquote class="lounge-banner-quote">
        <p>«Любая достаточно развитая технология неотличима от магии»</p>
        <cite>Артур Кларк</cite>
    </blockquote>
</header>

<div class="layout">

    <%- include('../partials/sidebar') %>

    <main class="content">
        <%- body %>
    </main>

</div>


<script>
document.addEventListener('DOMContentLoaded', () => {
    const sidebar = document.querySelector('.sidebar');

    if (!sidebar) return;

    const savedPosition = sessionStorage.getItem('gostinayaSidebarScroll');

    if (savedPosition !== null) {
        requestAnimationFrame(() => {
            sidebar.scrollTop = Number(savedPosition);
        });
    }

    sidebar.addEventListener('scroll', () => {
        sessionStorage.setItem(
            'gostinayaSidebarScroll',
            String(sidebar.scrollTop)
        );
    });

    sidebar.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
            sessionStorage.setItem(
                'gostinayaSidebarScroll',
                String(sidebar.scrollTop)
            );
        });
    });
});
</script>

</body>
</html>
