<!doctype html>
<html lang="ru" data-lounge-lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title><%= title %> — Гостиная / The Lounge</title>
<link rel="stylesheet" type="text/css" href="/gostinaya/public/gostinaya.css?v=20260815-1">
<link rel="stylesheet" type="text/css" href="/gostinaya/public/gostinaya-logo.css?v=20260822-1">
<link rel="stylesheet" type="text/css" href="/gostinaya/public/lounge-language.css?v=20260919-4">
<script>
(() => {
  const params = new URLSearchParams(window.location.search);
  const requested = params.get('lang');
  const stored = localStorage.getItem('loungeLanguage');
  const accountLanguage = <%- JSON.stringify(currentGuest?.language === 'en' ? 'en' : 'ru') %>;
  const lang = ['ru', 'en'].includes(requested)
    ? requested
    : (['ru', 'en'].includes(stored) ? stored : accountLanguage);
  document.documentElement.dataset.loungeLang = lang;
  document.documentElement.lang = lang;
  localStorage.setItem('loungeLanguage', lang);
})();
</script>
</head>

<body>

<header class="lounge-banner">
    <img class="lounge-banner-image" src="/gostinaya/public/lounge-banner-center.jpg" alt="После логина / After Login">

    <div class="lounge-banner-title">
        <img class="lounge-banner-brand-logo" src="/gostinaya/public/after-login-logo-transparent.png" alt="После логина / After Login">
        <span class="lounge-banner-name" data-lang="ru">Гостиная</span>
        <span class="lounge-banner-name" data-lang="en">The Lounge</span>
    </div>

    <blockquote class="lounge-banner-quote">
        <div data-lang="ru">
            <p>«Любая достаточно развитая технология неотличима от магии»</p>
            <cite>Артур Кларк</cite>
        </div>
        <div data-lang="en">
            <p>“Any sufficiently advanced technology is indistinguishable from magic.”</p>
            <cite>Arthur C. Clarke</cite>
        </div>
    </blockquote>
</header>

<div class="layout">
    <%- include('../partials/sidebar') %>

    <main class="content">
        <div class="authenticated-language-switch language-switch" aria-label="Language">
            <button type="button" data-set-language="ru">RU</button>
            <span aria-hidden="true">/</span>
            <button type="button" data-set-language="en">EN</button>
        </div>
        <%- body %>
    </main>
</div>

<script>
function applyLanguageDependentAttributes(lang) {
    document.querySelectorAll('[data-placeholder-ru][data-placeholder-en]').forEach(element => {
        element.setAttribute('placeholder', lang === 'en' ? element.dataset.placeholderEn : element.dataset.placeholderRu);
    });

    document.querySelectorAll('[data-title-ru][data-title-en]').forEach(element => {
        element.setAttribute('title', lang === 'en' ? element.dataset.titleEn : element.dataset.titleRu);
    });
}

function setLoungeLanguage(lang) {
    if (!['ru', 'en'].includes(lang)) return;
    document.documentElement.dataset.loungeLang = lang;
    document.documentElement.lang = lang;
    localStorage.setItem('loungeLanguage', lang);
    document.querySelectorAll('[data-set-language]').forEach(button => {
        button.setAttribute('aria-pressed', String(button.dataset.setLanguage === lang));
    });
    applyLanguageDependentAttributes(lang);
    document.dispatchEvent(new CustomEvent('lounge-language-change', { detail: { lang } }));
}

document.addEventListener('DOMContentLoaded', () => {
    setLoungeLanguage(document.documentElement.dataset.loungeLang || 'ru');

    document.querySelectorAll('[data-set-language]').forEach(button => {
        button.addEventListener('click', () => setLoungeLanguage(button.dataset.setLanguage));
    });

    const sidebar = document.querySelector('.sidebar');
    if (!sidebar) return;

    const savedPosition = sessionStorage.getItem('gostinayaSidebarScroll');
    if (savedPosition !== null) {
        requestAnimationFrame(() => {
            sidebar.scrollTop = Number(savedPosition);
        });
    }

    sidebar.addEventListener('scroll', () => {
        sessionStorage.setItem('gostinayaSidebarScroll', String(sidebar.scrollTop));
    });

    sidebar.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
            sessionStorage.setItem('gostinayaSidebarScroll', String(sidebar.scrollTop));
        });
    });
});
</script>

</body>
</html>
