<!doctype html>
<html lang="<%= language === 'en' ? 'en' : 'ru' %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title><%= title %> — <%= language === 'en' ? 'After Login' : 'После логина' %></title>
  <style>
    :root { color-scheme: dark; }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      color: #f4f1f8;
      background:
        radial-gradient(circle at 18% 12%, rgba(105, 65, 198, .22), transparent 34rem),
        radial-gradient(circle at 82% 88%, rgba(42, 124, 170, .14), transparent 32rem),
        #0c1018;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
    }
    .newsletter-shell {
      width: min(100% - 36px, 760px);
      margin: 0 auto;
      padding: 42px 0 64px;
    }
    .newsletter-brand {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 72px;
      color: #b49aff;
      font-size: 15px;
      font-weight: 800;
      letter-spacing: .12em;
      text-decoration: none;
    }
    .newsletter-brand-mark { color: #8ee7ff; }
    .newsletter-content { width: 100%; }
    .newsletter-status {
      max-width: 44rem;
      margin: 0 auto;
      padding: 36px;
      color: #182230;
      background: #fbf8f3;
      border: 1px solid rgba(255, 255, 255, .3);
      border-radius: 20px;
      box-shadow: 0 24px 70px rgba(0, 0, 0, .35);
    }
    .newsletter-status h1 {
      margin: 0 0 20px;
      color: #182230;
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(30px, 6vw, 42px);
      line-height: 1.15;
    }
    .newsletter-status p { color: #394354; line-height: 1.65; }
    .newsletter-status form { margin: 26px 0 18px; }
    .newsletter-status .button {
      display: inline-block;
      width: 100%;
      padding: 14px 18px;
      border: 0;
      border-radius: 11px;
      color: #fff;
      background: #6941c6;
      font: inherit;
      font-weight: 750;
      text-align: center;
      text-decoration: none;
      cursor: pointer;
    }
    .newsletter-status a:not(.button) { color: #4b3195; }
    @media (max-width: 540px) {
      .newsletter-shell { padding-top: 28px; }
      .newsletter-brand { margin-bottom: 44px; }
      .newsletter-status { padding: 28px 22px; }
    }
  </style>
</head>
<body>
  <main class="newsletter-shell">
    <a class="newsletter-brand" href="<%= language === 'en' ? '/en/' : '/' %>">
      <span class="newsletter-brand-mark">&gt;_</span>
      <span><%= language === 'en' ? 'AFTER LOGIN' : 'ПОСЛЕ ЛОГИНА' %></span>
    </a>
    <div class="newsletter-content"><%- body %></div>
  </main>
</body>
</html>
