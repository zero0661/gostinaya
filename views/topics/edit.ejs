<section class="profile-page room-page topic-page topic-edit-page">

  <header class="profile-header room-page-header topic-page-header">
    <p class="profile-eyebrow">
      Редактирование темы /
      <span>Edit Topic</span>
    </p>

    <h1>
      Изменить название темы /
      <span class="en-secondary">Edit Topic Title</span>
    </h1>

    <p>
      Измените название темы и сохраните изменения.
      <br>
      <span>Edit the topic title and save your changes.</span>
    </p>
  </header>

  <section class="profile-card room-panel topic-panel topic-composer">
    <div class="room-panel-header">
      <div>
        <h2>
          Название темы /
          <span>Topic Title</span>
        </h2>
      </div>
    </div>

    <form
      method="post"
      action="/gostinaya/topic/<%= topic.id %>/edit"
    >
      <label for="title">
        Название /
        <span class="en-secondary">Title</span>

        <input
          id="title"
          type="text"
          name="title"
          value="<%= topic.title %>"
          maxlength="200"
          required
        >
      </label>

      <div class="message-actions">
        <button type="submit">
          Сохранить изменения /
          <span class="en-secondary">Save Changes</span>
        </button>

        <a href="/gostinaya/topic/<%= topic.id %>">
          Отмена /
          <span class="en-secondary">Cancel</span>
        </a>
      </div>
    </form>
  </section>

  <nav class="room-navigation">
    <a href="/gostinaya/topic/<%= topic.id %>">
      ← Вернуться к теме /
      <span class="en-secondary">Back to Topic</span>
    </a>
  </nav>

</section>
