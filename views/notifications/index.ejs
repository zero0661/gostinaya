<section class="profile-page notifications-page">
    <header class="profile-header">
        <p class="profile-eyebrow"><span data-lang="ru">Мой профиль</span><span data-lang="en">My Profile</span></p>
        <h1><span data-lang="ru">Уведомления</span><span data-lang="en">Notifications</span></h1>
        <p><span data-lang="ru">Ответы, новые сообщения и события сообщества.</span><span data-lang="en">Replies, new messages and community activity.</span></p>
    </header>

    <section class="profile-card notifications-card">
        <div class="notifications-heading">
            <h2><span data-lang="ru">Последние уведомления</span><span data-lang="en">Latest notifications</span></h2>
            <% if (notifications.some(item => !item.read_at)) { %>
                <form method="post" action="/gostinaya/notifications/read-all">
                    <button type="submit"><span data-lang="ru">Отметить все прочитанными</span><span data-lang="en">Mark all as read</span></button>
                </form>
            <% } %>
        </div>

        <% if (!notifications.length) { %>
            <p><span data-lang="ru">У вас пока нет уведомлений.</span><span data-lang="en">You have no notifications yet.</span></p>
        <% } else { %>
            <div class="notifications-list">
                <% notifications.forEach(item => { %>
                    <article class="notification-item <%= item.read_at ? 'is-read' : 'is-unread' %>">
                        <div class="notification-icon" aria-hidden="true"><%= item.type === 'reply' ? '↩' : item.type === 'publication' ? '✦' : item.type === 'project_news' ? '📣' : item.type === 'new_topic' ? '✎' : '◌' %></div>
                        <div class="notification-content">
                            <div class="notification-meta">
                                <span class="notification-kind">
                                    <span data-lang="ru"><%= item.type === 'reply' ? 'Ответ' : item.type === 'publication' ? 'Публикация' : item.type === 'project_news' ? 'Новость проекта' : item.type === 'new_topic' ? 'Новая тема' : item.type === 'article_discussion' ? 'Обсуждение статьи' : 'Обсуждение' %></span>
                                    <span data-lang="en"><%= item.type === 'reply' ? 'Reply' : item.type === 'publication' ? 'Publication' : item.type === 'project_news' ? 'Project news' : item.type === 'new_topic' ? 'New topic' : item.type === 'article_discussion' ? 'Article discussion' : 'Discussion' %></span>
                                </span>
                                <span class="notification-state">
                                    <span data-lang="ru"><%= item.read_at ? '✓ Прочитано' : '● Новое' %></span>
                                    <span data-lang="en"><%= item.read_at ? '✓ Read' : '● New' %></span>
                                </span>
                            </div>

                            <p class="notification-message">
                                <strong><%= item.actor_name || '' %></strong>
                                <% if (!item.actor_name) { %><strong data-lang="ru">Участник</strong><strong data-lang="en">Member</strong><% } %>
                                <span><%= item.text %></span>
                            </p>

                            <% if (item.topic_title) { %>
                                <p class="notification-topic">
                                    <span data-lang="ru">В теме:</span><span data-lang="en">In topic:</span>
                                    <strong><%= item.topic_title %></strong>
                                </p>
                            <% } %>

                            <div class="notification-footer">
                                <% if (item.topic_id) { %>
                                    <a class="notification-open" href="/gostinaya/notifications/<%= item.id %>/open">
                                        <% if (item.message_id) { %>
                                            <span data-lang="ru">Перейти к сообщению →</span><span data-lang="en">Go to message →</span>
                                        <% } else { %>
                                            <span data-lang="ru">Открыть обсуждение →</span><span data-lang="en">Open discussion →</span>
                                        <% } %>
                                    </a>
                                <% } %>
                                <time datetime="<%= String(item.created_at).replace(' ', 'T') %>Z" data-notification-time><%= item.created_at %></time>
                            </div>
                        </div>
                    </article>
                <% }) %>
            </div>
        <% } %>
    </section>
</section>

<script>
function formatNotificationTimes() {
    const lang = document.documentElement.dataset.loungeLang === 'en' ? 'en-GB' : 'ru-RU';
    document.querySelectorAll('[data-notification-time]').forEach((element) => {
        const raw = element.getAttribute('datetime');
        const date = new Date(raw);
        if (!Number.isNaN(date.getTime())) {
            element.textContent = new Intl.DateTimeFormat(lang, {
                day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit'
            }).format(date);
        }
    });
}
document.addEventListener('DOMContentLoaded', formatNotificationTimes);
document.addEventListener('lounge-language-change', formatNotificationTimes);
</script>
