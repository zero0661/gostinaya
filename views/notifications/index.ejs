<section class="profile-page notifications-page">
    <header class="profile-header">
        <p class="profile-eyebrow">Мой профиль / <span>My Profile</span></p>
        <h1>Уведомления <span>/ Notifications</span></h1>
        <p>
        Ответы, новые сообщения и события сообщества.<br>
        <span>Replies, new messages and community activity.</span>
        </p>
    </header>

    <section class="profile-card notifications-card">
        <div class="notifications-heading">
            <h2>Последние уведомления <span>/ Latest notifications</span></h2>

            <% if (notifications.some(item => !item.read_at)) { %>
                <form
                    method="post"
                    action="/gostinaya/notifications/read-all"
                >
                    <button type="submit">
                        Отметить все прочитанными
                    </button>
                </form>
            <% } %>
        </div>

        <% if (!notifications.length) { %>
            <p>У вас пока нет уведомлений. <span>/ You have no notifications yet.</span></p>
        <% } else { %>
            <div class="notifications-list">
                <% notifications.forEach(item => { %>
                    <article
                        class="notification-item <%= item.read_at ? 'is-read' : 'is-unread' %>"
                    >
                        <div class="notification-icon" aria-hidden="true">
                            <%= item.type === 'reply' ? '↩' : item.type === 'publication' ? '✦' : item.type === 'project_news' ? '📣' : item.type === 'new_topic' ? '✎' : '◌' %>
                        </div>

                        <div class="notification-content">
                            <div class="notification-meta">
                                <span class="notification-kind">
                                    <%= item.type === 'reply'
                                        ? 'Ответ / Reply'
                                        : item.type === 'publication'
                                            ? 'Публикация / Publication'
                                            : item.type === 'project_news'
                                                ? 'Новость проекта / Project news'
                                            : item.type === 'new_topic'
                                                ? 'Новая тема / New topic'
                                                : item.type === 'article_discussion'
                                                    ? 'Обсуждение статьи / Article discussion'
                                                    : 'Обсуждение / Discussion' %>
                                </span>
                                <span class="notification-state">
                                    <%= item.read_at ? '✓ Прочитано / Read' : '● Новое / New' %>
                                </span>
                            </div>

                            <p class="notification-message">
                                <strong><%= item.actor_name || 'Участник / Member' %></strong>
                                <span><%= item.text %></span>
                            </p>

                            <% if (item.topic_title) { %>
                                <p class="notification-topic">
                                    В теме / <em>In topic</em>:
                                    <strong><%= item.topic_title %></strong>
                                </p>
                            <% } %>

                            <div class="notification-footer">
                                <% if (item.topic_id) { %>
                                    <a class="notification-open" href="/gostinaya/notifications/<%= item.id %>/open">
                                        <%= item.message_id ? 'Перейти к сообщению / Go to message' : 'Открыть обсуждение / Open discussion' %>
                                        <span aria-hidden="true">→</span>
                                    </a>
                                <% } %>

                                <time datetime="<%= String(item.created_at).replace(' ', 'T') %>Z" data-notification-time><%= item.created_at %></time>
                            </div>
                        </div>
                    </article>
                <% }) %>
            </div>
        <% } %>
    </section>
</section>

<script>
document.querySelectorAll('[data-notification-time]').forEach((element) => {
    const raw = element.getAttribute('datetime');
    const date = new Date(raw);

    if (!Number.isNaN(date.getTime())) {
        element.textContent = new Intl.DateTimeFormat('ru-RU', {
            day: '2-digit',
            month: '2-digit',
            year: 'numeric',
            hour: '2-digit',
            minute: '2-digit'
        }).format(date);
    }
});
</script>
