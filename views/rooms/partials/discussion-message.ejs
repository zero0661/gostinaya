<article
    class="message-item topic-message-card <%= parentAuthor ? 'thread-reply' : 'thread-root' %> <%= message.hidden_at ? 'is-moderated-hidden' : '' %>"
    id="message-<%= message.id %>"
>
    <header class="topic-message-header">
        <strong class="topic-message-author">
            <a href="/gostinaya/member/<%= message.author_id %>"><%= message.author %></a>
        </strong>
        <span class="topic-message-date"><%= formatMoscowDateTime(message.created_at) %></span>
    </header>

    <div class="topic-message-body">
        <p data-translation-message-id="<%= message.id %>"><%- linkifyText(message.body) %></p>
    </div>

    <% if (!message.hidden_at) { %>
    <div class="message-actions topic-message-actions">
        <button type="button" class="reply-button" data-message-id="<%= message.id %>" data-author="<%= message.author %>">
            <span data-lang="ru">Ответить</span>
            <span data-lang="en">Reply</span>
        </button>

        <% if (Number(currentUserId) === Number(message.author_id)) { %>
            <a href="/gostinaya/message/<%= message.id %>/edit">
                <span data-lang="ru">Редактировать</span>
                <span data-lang="en">Edit</span>
            </a>
        <% } %>
    </div>

    <details class="report-control">
        <summary>
            <span data-lang="ru">Пожаловаться</span>
            <span data-lang="en">Report</span>
        </summary>
        <form method="post" action="/gostinaya/reports">
            <input type="hidden" name="topic_id" value="<%= topicId %>">
            <input type="hidden" name="message_id" value="<%= message.id %>">
            <textarea name="reason" maxlength="500" rows="3" data-placeholder-ru="Что произошло?" data-placeholder-en="What happened?" required></textarea>
            <button type="submit">
                <span data-lang="ru">Отправить</span>
                <span data-lang="en">Send</span>
            </button>
        </form>
    </details>
    <% } %>

    <div class="reply-form-slot" data-message-id="<%= message.id %>"></div>

    <% const directReplies = repliesByParent.get(Number(message.id)) || repliesByParent.get(String(message.id)) || []; %>
    <% if (directReplies.length) { %>
        <div class="thread-replies">
            <% directReplies.forEach(reply => { %>
                <%- include('discussion-message', {
                    message: reply,
                    parentAuthor: message.author,
                    repliesByParent,
                    countThreadReplies,
                    currentUserId,
                    topicId
                }) %>
            <% }) %>
        </div>
    <% } %>
</article>
