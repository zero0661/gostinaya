<section class="profile-page room-page">
  <header class="profile-header room-page-header">
    <h1>
      <% if (roomKey === 'news') { %>
        <span data-lang="ru">Новая новость</span><span data-lang="en">New Project News</span>
      <% } else { %>
        <span data-lang="ru">Новая тема</span><span data-lang="en">New Topic</span>
      <% } %>
    </h1>
    <p>
      <% if (roomKey === 'news') { %>
        <span data-lang="ru">Одна новость, две языковые версии и одно общее обсуждение.</span><span data-lang="en">One news item, two language versions and one shared discussion.</span>
      <% } else { %>
        <span data-lang="ru">Создайте новое обсуждение для участников Гостиной.</span><span data-lang="en">Create a new discussion for Lounge members.</span>
      <% } %>
    </p>
  </header>

  <form method="post" action="/gostinaya/<%= roomKey %>/new">
    <section class="profile-card room-pane">
      <h2>
        <% if (roomKey === 'news') { %>
          <span data-lang="ru">Новая публикация</span><span data-lang="en">New Announcement</span>
        <% } else { %>
          <span data-lang="ru">Новое обсуждение</span><span data-lang="en">New Discussion</span>
        <% } %>
      </h2>

      <% if (roomKey === 'news') { %>
        <div class="room-intro">
          <p data-lang="ru">Заполните обе версии. В ленте и внутри новости участник увидит только выбранный язык.</p>
          <p data-lang="en">Fill in both versions. Members will see only the language they have selected.</p>
        </div>

        <label>
          <span>RU · Заголовок</span>
          <input type="text" name="title_ru" maxlength="160" required autofocus>
        </label>

        <label>
          <span>RU · Текст</span>
          <textarea name="body_ru" rows="8" maxlength="5000" required></textarea>
        </label>

        <label>
          <span>EN · Title</span>
          <input type="text" name="title_en" maxlength="160" required>
        </label>

        <label>
          <span>EN · Text</span>
          <textarea name="body_en" rows="8" maxlength="5000" required></textarea>
        </label>
      <% } else { %>
        <label>
          <span data-lang="ru">Заголовок темы</span><span data-lang="en">Topic Title</span>
          <input type="text" name="title" maxlength="160" required autofocus>
        </label>

        <label>
          <span data-lang="ru">Первое сообщение</span><span data-lang="en">First Message</span>
          <textarea name="body" rows="10" maxlength="5000" required></textarea>
        </label>
      <% } %>

      <div class="room-intro">
        <p><span data-lang="ru">После публикации тема становится частью общего обсуждения.</span><span data-lang="en">Once published, the topic becomes part of the community discussion.</span></p>
        <p><span data-lang="ru">До появления первого ответа вы можете изменить название и текст.</span><span data-lang="en">Before the first reply, you can edit the title and text.</span></p>
        <p><span data-lang="ru">После появления ответов изменение или удаление темы возможно только через модератора.</span><span data-lang="en">After replies appear, the topic can be changed or deleted only by a moderator.</span></p>
      </div>

      <button type="submit">
        <% if (roomKey === 'news') { %>
          <span data-lang="ru">Опубликовать новость</span><span data-lang="en">Publish News</span>
        <% } else { %>
          <span data-lang="ru">Создать тему</span><span data-lang="en">Create Topic</span>
        <% } %>
      </button>
    </section>
  </form>

  <nav class="room-navigation">
    <a href="/gostinaya/<%= roomKey %>"><span data-lang="ru">← Вернуться к темам</span><span data-lang="en">← Back to Topics</span></a>
  </nav>
</section>
