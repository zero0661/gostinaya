<section class="room-page">
    <header class="room-header">
        <p class="room-kicker">Гостиная / The Lounge</p>
        <h1><%= title %></h1>
        <p class="lead"><%= lead %></p>
    </header>

    <section class="room-card">
        <div class="room-card-header">
            <div>
                <h2>Темы</h2>
                <p>Разговоры этой комнаты.</p>
            </div>

            <% if (roomKey !== 'articles') { %>
        <a class="room-action" href="/gostinaya/<%= typeof roomKey !== 'undefined' ? roomKey : 'discussions' %>/new">
                Создать тему
            </a>
        <% } %>
        </div>

        <% if (topics.length === 0) { %>
            <div class="room-empty">
                <% if (roomKey === 'articles') { %><h3>Обсуждения появятся автоматически</h3><% } else { %><h3>Здесь пока тихо</h3><% } %>
                <p><%= text %></p>
            </div>
        <% } else { %>
            <div class="topic-list">
                <% topics.forEach((topic) => { %>
                    <article class="topic-item topic-card">
                        <h3>
                            <a href="/gostinaya/topic/<%= topic.id %>">
                                <%= topic.title %>
                            </a>
                        </h3>

                        <% if (topic.preview) { %>
                            <p class="topic-preview">
                                <%= topic.preview %><%= topic.preview.length >= 140 ? '…' : '' %>
                            </p>
                        <% } %>

                        <% if (Number(topic.unread_count || 0) > 0) { %>
  <span class="topic-unread">
    ● Новое: <%= topic.unread_count %>
  </span>
<% } %>

<div class="topic-meta">
                            <span>👤 <a href="/gostinaya/member/<%= topic.author_id %>"><%= topic.author %></a></span>
                            <span>
                                💬 <%= Math.max(Number(topic.replies || 0) - 1, 0) %>
                                <%= Math.max(Number(topic.replies || 0) - 1, 0) === 1 ? 'ответ' : 'ответов' %>
                            </span>

                            <% if (topic.last_reply_at) { %>
                                <span>
                                    🕒 <%= topic.last_reply_author %> ·
                                    <%= topic.last_reply_at %>
                                </span>
                            <% } %>

                            <% if (topic.pinned) { %>
                                <span>📌 Закреплено</span>
                            <% } %>

                            <% if (topic.closed) { %>
                                <span>🔒 Закрыто</span>
                            <% } %>
                        </div>
                    </article>
                <% }) %>
            </div>
        <% } %>
    </section>

    <nav class="room-navigation">
        <a href="/gostinaya/hall">← Вернуться в Холл</a>
    </nav>
</section>
