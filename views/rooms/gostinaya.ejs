<section class="profile-page room-page">

  <header class="profile-header room-page-header">
    <p class="profile-eyebrow">
      <span data-lang="ru">Гостиная</span>
      <span data-lang="en">The Lounge</span>
    </p>

    <% if (roomKey === 'articles') { %>
      <h1 data-lang="ru">Обсуждение статей</h1>
      <h1 data-lang="en">Article Discussions</h1>
    <% } else if (roomKey === 'news') { %>
      <h1 data-lang="ru">Новости проекта</h1>
      <h1 data-lang="en">Project News</h1>
    <% } else { %>
      <h1 data-lang="ru">Темы сообщества</h1>
      <h1 data-lang="en">Community Topics</h1>
    <% } %>

    <div>
      <% if (roomKey === 'articles') { %>
        <p data-lang="ru">Все статьи проекта и комментарии к ним.</p>
        <p data-lang="en">All project articles and their discussions.</p>
      <% } else if (roomKey === 'news') { %>
        <p data-lang="ru">Новые материалы, аудиоверсии, объявления и изменения проекта.</p>
        <p data-lang="en">New materials, audio editions, announcements and project updates.</p>
      <% } else { %>
        <p data-lang="ru">Свободные обсуждения участников Гостиной.</p>
        <p data-lang="en">Open discussions among Lounge members.</p>
      <% } %>
    </div>
  </header>

  <section class="profile-card room-panel">
    <div class="room-panel-header">
      <div>
        <h2>
          <% if (roomKey === 'articles') { %>
            <span data-lang="ru">Обсуждения</span>
            <span data-lang="en">Discussions</span>
          <% } else if (roomKey === 'news') { %>
            <span data-lang="ru">Новости</span>
            <span data-lang="en">News</span>
          <% } else { %>
            <span data-lang="ru">Темы</span>
            <span data-lang="en">Topics</span>
          <% } %>
        </h2>

        <% if (roomKey === 'articles') { %>
          <p data-lang="ru">Разговоры о публикациях проекта.</p>
          <p data-lang="en">Conversations about project publications.</p>
        <% } else if (roomKey === 'news') { %>
          <p data-lang="ru">Каждая новость проекта открыта для обсуждения.</p>
          <p data-lang="en">Every project news item is open for discussion.</p>
        <% } else { %>
          <p data-lang="ru">Разговоры этого пространства.</p>
          <p data-lang="en">Conversations in this space.</p>
        <% } %>
      </div>

      <% if (canCreateTopic) { %>
        <a class="room-action" href="/gostinaya/<%= typeof roomKey !== 'undefined' ? roomKey : 'discussions' %>/new">
          <% if (roomKey === 'news') { %>
            <span data-lang="ru">Опубликовать новость</span>
            <span data-lang="en">Publish news</span>
          <% } else { %>
            <span data-lang="ru">Создать тему</span>
            <span data-lang="en">New topic</span>
          <% } %>
        </a>
      <% } %>
    </div>

    <% if (roomKey === 'articles') { %>
      <% if (!articleDiscussions || articleDiscussions.length === 0) { %>
        <div class="room-empty">
          <h3 data-lang="ru">Обсуждения появятся автоматически</h3>
          <h3 data-lang="en">Discussions will appear automatically</h3>
          <p data-lang="ru">Каждая пара русской и английской публикаций получает одну общую дискуссию.</p>
          <p data-lang="en">Each Russian/English article pair gets one shared discussion.</p>
        </div>
      <% } else { %>
        <div class="article-discussion-list">
          <% articleDiscussions.forEach(discussion => { %>
            <article class="article-discussion-card">
              <% const isPair = Boolean(discussion.article_ru && discussion.article_en); %>
              <% const ruImage = discussion.article_ru?.image || discussion.article_en?.image; %>
              <% const enImage = discussion.article_en?.image || discussion.article_ru?.image; %>

              <% if (isPair) { %>
                <% if (ruImage) { %>
                  <div class="article-shared-image-wrap" data-lang="ru">
                    <img src="<%= ruImage %>" alt="" class="article-shared-image">
                  </div>
                <% } %>
                <% if (enImage) { %>
                  <div class="article-shared-image-wrap" data-lang="en">
                    <img src="<%= enImage %>" alt="" class="article-shared-image">
                  </div>
                <% } %>
              <% } else { %>
                <% const singleImage = discussion.article_ru?.image || discussion.article_en?.image; %>
                <% if (singleImage) { %>
                  <div class="article-shared-image-wrap">
                    <img src="<%= singleImage %>" alt="" class="article-shared-image">
                  </div>
                <% } %>
              <% } %>

              <div class="article-language-grid article-language-single">
                <% if (discussion.article_ru) { %>
                  <a class="article-language-card" <%- isPair ? 'data-lang="ru"' : '' %>
                     href="<%= discussion.url_ru %>" target="_blank" rel="noopener">
                    <div class="article-language-body">
                      <span class="article-language-label">RU</span>
                      <h3><%= discussion.article_ru.title %></h3>
                      <% if (discussion.article_ru.excerpt) { %>
                        <p><%= discussion.article_ru.excerpt %></p>
                      <% } %>
                      <span class="article-read-link">Читать статью →</span>
                    </div>
                  </a>
                <% } %>

                <% if (discussion.article_en) { %>
                  <a class="article-language-card" <%- isPair ? 'data-lang="en"' : '' %>
                     href="<%= discussion.url_en %>" target="_blank" rel="noopener">
                    <div class="article-language-body">
                      <span class="article-language-label">EN</span>
                      <h3><%= discussion.article_en.title %></h3>
                      <% if (discussion.article_en.excerpt) { %>
                        <p><%= discussion.article_en.excerpt %></p>
                      <% } %>
                      <span class="article-read-link">Read article →</span>
                    </div>
                  </a>
                <% } %>
              </div>

              <div class="article-discussion-footer">
                <div class="article-discussion-stats">
                  <strong data-lang="ru">Обсуждение</strong>
                  <strong data-lang="en">Discussion</strong>

                  <span data-lang="ru">💬 <%= Number(discussion.messages_count || 0) %> сообщений</span>
                  <span data-lang="en">💬 <%= Number(discussion.messages_count || 0) %> messages</span>

                  <% if (discussion.last_message_at) { %>
                    <span>🕘 <%= discussion.last_message_author %> · <%= formatMoscowDateTime(discussion.last_message_at) %></span>
                  <% } %>
                </div>

                <a class="room-action article-discussion-action" href="/gostinaya/topic/<%= discussion.topic_id %>">
                  <span data-lang="ru">Обсудить</span>
                  <span data-lang="en">Join Discussion</span>
                </a>
              </div>
            </article>
          <% }) %>
        </div>
      <% } %>

    <% } else { %>
      <% if (topics.length === 0) { %>
        <div class="room-empty">
          <% if (roomKey === 'news') { %>
            <h3 data-lang="ru">Новостей пока нет</h3>
            <h3 data-lang="en">No news yet</h3>
          <% } else { %>
            <h3 data-lang="ru">Здесь пока тихо</h3>
            <h3 data-lang="en">It is quiet here for now</h3>
          <% } %>
          <% if (roomKey === 'news') { %>
            <p data-lang="ru">Здесь появляются новости проекта, которые можно обсудить вместе с участниками Гостиной.</p>
            <p data-lang="en">Project news appears here and can be discussed with other Lounge members.</p>
          <% } else { %>
            <p data-lang="ru">Здесь участники могут создавать собственные темы для обсуждения.</p>
            <p data-lang="en">Members can start their own discussion topics here.</p>
          <% } %>
        </div>
      <% } else { %>
        <div class="topic-list">
          <% topics.forEach(topic => { %>
            <article class="topic-item">
              <div class="topic-main">
                <h3><a href="/gostinaya/topic/<%= topic.id %>"><%= topic.title %></a></h3>
                <% if (topic.preview) { %>
                  <p class="topic-preview"><%= topic.preview %><%= topic.preview.length >= 140 ? '…' : '' %></p>
                <% } %>
                <% if (Number(topic.unread_count || 0) > 0) { %>
                  <span class="topic-unread" data-lang="ru">Новое: <%= topic.unread_count %></span>
                  <span class="topic-unread" data-lang="en">New: <%= topic.unread_count %></span>
                <% } %>
              </div>

              <div class="topic-meta">
                <span>👤 <a href="/gostinaya/member/<%= topic.author_id %>"><%= topic.author %></a></span>
                <span data-lang="ru">💬 <%= Math.max(Number(topic.replies || 0) - 1, 0) %> ответов</span>
                <span data-lang="en">💬 <%= Math.max(Number(topic.replies || 0) - 1, 0) %> replies</span>
                <% if (topic.last_reply_at) { %>
                  <span>🕘 <%= topic.last_reply_author %> · <%= topic.last_reply_at %></span>
                <% } %>
                <% if (topic.pinned) { %>
                  <span data-lang="ru">📌 Закреплено</span><span data-lang="en">📌 Pinned</span>
                <% } %>
                <% if (topic.closed) { %>
                  <span data-lang="ru">🔒 Закрыто</span><span data-lang="en">🔒 Closed</span>
                <% } %>
              </div>
            </article>
          <% }) %>
        </div>
      <% } %>
    <% } %>
  </section>

  <nav class="room-navigation">
    <a href="/gostinaya/hall">
      <span data-lang="ru">← Вернуться в Холл</span>
      <span data-lang="en">← Back to Hall</span>
    </a>
  </nav>

</section>
