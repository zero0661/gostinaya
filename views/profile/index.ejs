<section class="profile-page">

    <%
        const joinedDate = guest.created_at
            ? new Date(
                guest.created_at.replace(' ', 'T') + 'Z'
              ).toLocaleDateString('ru-RU', {
                  day: 'numeric',
                  month: 'long',
                  year: 'numeric'
              })
            : '—';

  const joinedDateEn = guest.created_at
    ? new Date(
        guest.created_at.replace(' ', 'T') + 'Z'
      ).toLocaleDateString('en-GB', {
        day: 'numeric',
        month: 'long',
        year: 'numeric'
      })
    : '—';
    %>

    <header class="profile-header">
    <p class="profile-eyebrow">Мой профиль / <span>My Profile</span></p>
    <h1><%= guest.name %></h1>
    <p>Ваше личное пространство в Гостиной.<br><span>Your personal space in the Lounge.</span></p>
</header>

    <% if (saved) { %>
        <p class="profile-success" id="profile-success">
            Настройки сохранены.<br><span>Settings saved successfully.</span>
        </p>

        <script>
            window.history.replaceState(
                {},
                document.title,
                '/gostinaya/profile'
            );

            window.setTimeout(() => {
                const notice = document.getElementById('profile-success');

                if (notice) {
                    notice.style.opacity = '0';
                    notice.style.transform = 'translateY(-6px)';

                    window.setTimeout(() => notice.remove(), 300);
                }
            }, 4000);
        </script>
    <% } %>

    <form method="post" action="/gostinaya/profile">

        <section class="profile-card">
            <h2>Профиль участника<br><span>Profile</span></h2>

            <label>
                Имя<br><span>Name</span>
                <input
                    type="text"
                    name="name"
                    value="<%= guest.name %>"
                    maxlength="80"
                    required
                >
            </label>

            <label>
                E-mail<br><span>E-mail</span>
                <input
                    type="email"
                    value="<%= guest.email %>"
                    disabled
                >
            </label>

            <label>
                Откуда вы?<br><span>Where are you from?</span>
                <input
                    type="text"
                    name="location"
                    value="<%= guest.location %>"
                    maxlength="120"
                    placeholder="Город, страна или «не скажу»"
                >
            </label>

            <label>
                Язык общения<br><span>Language</span>
                <select name="language">
                    <option value="ru" <%= guest.language === 'ru' ? 'selected' : '' %>>
                        Русский
                    </option>
                    <option value="en" <%= guest.language === 'en' ? 'selected' : '' %>>
                        English
                    </option>
                </select>
            </label>

            <label>
                О себе<br><span>About</span>
                <textarea
                    name="bio"
                    maxlength="1000"
                    rows="6"
                    placeholder="Несколько слов, которыми вы хотите представиться"
                ><%= guest.bio %></textarea>
            </label>
        </section>

        <section class="profile-card">
            <h2>Уведомления<br><span>Notifications</span></h2>

            <p class="notification-preferences-intro">
                Выберите события, которые будут появляться в вашем личном кабинете.<br>
                <span>Choose which events will appear in your personal account.</span>
            </p>

            <label>
                <input
                    type="checkbox"
                    name="notify_replies"
                    <%= guest.notify_replies ? 'checked' : '' %>
                >
                Ответы на мои сообщения <span>/ Replies to my messages</span>
            </label>

            <label>
                <input
                    type="checkbox"
                    name="notify_followed_discussions"
                    <%= guest.notify_followed_discussions ? 'checked' : '' %>
                >
                Новые сообщения в обсуждениях, за которыми я слежу <span>/ New messages in followed discussions</span>
            </label>

            <label>
                <input
                    type="checkbox"
                    name="notify_all_article_discussions"
                    <%= guest.notify_all_article_discussions ? 'checked' : '' %>
                >
                Все новые сообщения во всех обсуждениях статей <span>/ All new messages in every article discussion</span>
            </label>

            <label>
                <input
                    type="checkbox"
                    name="notify_publications"
                    <%= guest.notify_publications ? 'checked' : '' %>
                >
                Новые публикации проекта <span>/ New project publications</span>
            </label>

            <label>
                <input
                    type="checkbox"
                    name="notify_new_topics"
                    <%= guest.notify_new_topics ? 'checked' : '' %>
                >
                Новые темы в Гостиной <span>/ New topics in the Lounge</span>
            </label>

            <div class="notification-delivery">
                <h3>Доставка на почту <span>/ E-mail delivery</span></h3>
                <p>
                    Дополнительно дублировать выбранные уведомления на e-mail.<br>
                    <span>Also send the selected notifications by e-mail.</span>
                </p>

                <label>
                    <input
                        type="checkbox"
                        name="notify_email"
                        <%= guest.notify_email ? 'checked' : '' %>
                    >
                    Получать уведомления также на e-mail <span>/ Also receive notifications by e-mail</span>
                </label>
            </div>

            <button type="submit">
                Сохранить изменения / <span class="en-secondary">Save Changes</span>
            </button>
        </section>

    </form>

    <section class="profile-card">
        <h2>Сведения об аккаунте<br><span>Account information</span></h2>

        <dl class="profile-details">
            <div>
                <dt>Роль<br><span>Role</span></dt>
                <dd>
          <%= guest.role === 'author'
            ? 'Соавтор'
            : guest.role === 'admin'
              ? 'Администратор'
              : 'Участник' %> /
          <span class="en-secondary"><%= guest.role === 'author'
            ? 'Co-author'
            : guest.role === 'admin'
              ? 'Administrator'
              : 'Member' %></span>
        </dd>
            </div>

            <div>
                <dt>В Гостиной с<br><span>Member since</span></dt>
                <dd><%= joinedDate %> / <span class="en-secondary"><%= joinedDateEn %></span></dd>
            </div>
        </dl>
    </section>

    <nav class="profile-navigation">
        <a href="/gostinaya/hall">← Вернуться в Холл / <span>Back to Hall</span></a>

        <form method="post" action="/gostinaya/logout">
            <button type="submit">Выйти из аккаунта / <span>Sign out</span></button>
        </form>
    </nav>

</section>
