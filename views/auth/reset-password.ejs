<section class="auth-page lounge-language-page">
  <nav class="public-nav" aria-label="Language-aware navigation">
    <a href="/gostinaya/">
      <span data-lang="ru">← Добро пожаловать</span>
      <span data-lang="en">← Welcome</span>
    </a>
    <a href="https://milenin.pro/">
      <span data-lang="ru">⌂ На сайт проекта</span>
      <span data-lang="en">⌂ Main website</span>
    </a>
  </nav>

  <div class="auth-card">
    <div data-lang="ru">
      <h1>Новый пароль</h1>
      <p class="auth-intro">Придумайте новый пароль для входа в Гостиную.</p>
    </div>
    <div data-lang="en">
      <h1>New password</h1>
      <p class="auth-intro">Create a new password to sign in to the Lounge.</p>
    </div>

    <form id="reset-password-form" class="auth-form">
      <input type="hidden" id="reset-token" value="<%= token %>">

      <label for="password">
        <span data-lang="ru">Новый пароль</span>
        <span data-lang="en">New password</span>
      </label>
      <input id="password" type="password" minlength="8" required autocomplete="new-password">

      <label for="password-confirm">
        <span data-lang="ru">Повторите пароль</span>
        <span data-lang="en">Confirm password</span>
      </label>
      <input id="password-confirm" type="password" minlength="8" required autocomplete="new-password">

      <button type="submit">
        <span data-lang="ru">Сохранить пароль</span>
        <span data-lang="en">Save password</span>
      </button>

      <p id="reset-message" class="auth-message" aria-live="polite"></p>
    </form>

    <div class="auth-links">
      <a href="/gostinaya/login">
        <span data-lang="ru">Вернуться ко входу</span>
        <span data-lang="en">Back to sign in</span>
      </a>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('reset-password-form');
  const message = document.getElementById('reset-message');
  const ui = {
    ru: {
      mismatch: 'Пароли не совпадают.',
      success: 'Пароль успешно изменён. Переходим ко входу…',
      failure: 'Не удалось изменить пароль.'
    },
    en: {
      mismatch: 'Passwords do not match.',
      success: 'Password changed successfully. Redirecting to sign in…',
      failure: 'Could not change password.'
    }
  };

  const currentLang = () => document.documentElement.dataset.loungeLang === 'en' ? 'en' : 'ru';

  form.addEventListener('submit', async (event) => {
    event.preventDefault();

    const token = document.getElementById('reset-token').value;
    const password = document.getElementById('password').value;
    const confirmPassword = document.getElementById('password-confirm').value;
    const lang = currentLang();

    message.classList.remove('is-success', 'is-error');

    if (password !== confirmPassword) {
      message.classList.add('is-error');
      message.textContent = ui[lang].mismatch;
      return;
    }

    const response = await fetch('/gostinaya/api/guests/reset-password', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ token, password })
    });

    const data = await response.json();

    if (response.ok) {
      message.classList.add('is-success');
      message.textContent = ui[lang].success;
      form.querySelector('button[type="submit"]').disabled = true;
      setTimeout(() => { window.location.href = '/gostinaya/login'; }, 2000);
      return;
    }

    message.classList.add('is-error');
    message.textContent = data.message || ui[lang].failure;
  });
</script>
