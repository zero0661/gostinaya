<section class="auth-page">
  <nav class="public-nav" aria-label="Навигация / Navigation">
    <a href="/gostinaya/">← Добро пожаловать / <span>Welcome</span></a>
    <a href="https://milenin.pro/">⌂ На сайт проекта / <span>Main website</span></a>
  </nav>

  <div class="auth-card">
    <h1>
      Новый пароль<br>
      <span>New password</span>
    </h1>

    <p class="auth-intro">
      Придумайте новый пароль для входа в Гостиную.<br>
      <span>Create a new password to sign in to the Lounge.</span>
    </p>

    <form id="reset-password-form" class="auth-form">
      <input type="hidden" id="reset-token" value="<%= token %>">

      <label for="password">
        Новый пароль<br>
        <span>New password</span>
      </label>
      <input
        id="password"
        type="password"
        minlength="8"
        required
        autocomplete="new-password"
      >

      <label for="password-confirm">
        Повторите пароль<br>
        <span>Confirm password</span>
      </label>
      <input
        id="password-confirm"
        type="password"
        minlength="8"
        required
        autocomplete="new-password"
      >

      <button type="submit">
        Сохранить пароль<br>
        <span>Save password</span>
      </button>

      <p id="reset-message" class="auth-message" aria-live="polite"></p>
    </form>

    <div class="auth-links">
      <a href="/gostinaya/login">
        Вернуться ко входу / <span>Back to sign in</span>
      </a>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('reset-password-form');
  const message = document.getElementById('reset-message');

  form.addEventListener('submit', async (event) => {
    event.preventDefault();

    const token = document.getElementById('reset-token').value;
    const password = document.getElementById('password').value;
    const confirmPassword = document.getElementById('password-confirm').value;

    message.classList.remove('is-success', 'is-error');

    if (password !== confirmPassword) {
      message.classList.add('is-error');
      message.textContent =
        'Пароли не совпадают. / Passwords do not match.';
      return;
    }

    const response = await fetch('/gostinaya/api/guests/reset-password', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ token, password })
    });

    const data = await response.json();

    if (response.ok) {
      message.classList.add('is-success');
      message.textContent =
        'Пароль успешно изменён. Переходим ко входу… / Password changed successfully. Redirecting to sign in…';

      form.querySelector('button[type="submit"]').disabled = true;

      setTimeout(() => {
        window.location.href = '/gostinaya/login';
      }, 2000);

      return;
    }

    message.classList.add('is-error');
    message.textContent =
      data.message || 'Не удалось изменить пароль. / Could not change password.';
  });
</script>
