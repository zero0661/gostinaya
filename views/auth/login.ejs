<section class="auth-page">
  <nav class="public-nav" aria-label="<%= lang === 'en' ? 'Navigation' : 'Навигация' %>">
    <a href="/gostinaya?lang=<%= lang %>">← <%= lang === 'en' ? 'Welcome' : 'Добро пожаловать' %></a>
    <a href="<%= lang === 'en' ? 'https://milenin.pro/en-project-map/' : 'https://milenin.pro/' %>">⌂ <%= lang === 'en' ? 'Main website' : 'На сайт проекта' %></a>
  </nav>

  <div class="auth-card">
    <h1><%= lang === 'en' ? 'Sign in' : 'Вход' %></h1>

    <p class="auth-intro">
      <%= lang === 'en'
        ? 'Enter your e-mail and we will send a sign-in link.'
        : 'Укажите e-mail — мы пришлём ссылку для входа.' %>
    </p>

    <form id="login-form" class="auth-form">
      <label for="email">E-mail</label>
      <input
        id="email"
        name="email"
        type="email"
        autocomplete="email"
        required
      >

      <button type="submit"><%= lang === 'en' ? 'Sign in' : 'Войти' %></button>

      <p id="login-message" class="auth-message" aria-live="polite"></p>
    </form>

    <div class="auth-links">
      <p>
        <%= lang === 'en' ? 'No account yet?' : 'Нет аккаунта?' %>
        <a href="/gostinaya/register?lang=<%= lang %><%= returnTo ? `&returnTo=${encodeURIComponent(returnTo)}` : '' %>">
          <%= lang === 'en' ? 'Register' : 'Зарегистрироваться' %>
        </a>
      </p>
    </div>
  </div>
</section>

<script>
    const form = document.getElementById('login-form');
    const message = document.getElementById('login-message');
    const returnTo = <%- JSON.stringify(returnTo || '') %>;
    const language = <%- JSON.stringify(lang) %>;

    form.addEventListener('submit', async (event) => {
        event.preventDefault();

        message.textContent = language === 'en'
            ? 'Checking your details...'
            : 'Проверяем данные...';

        const email = document.getElementById('email').value.trim();

        try {
            const response = await fetch('/gostinaya/api/guests/login', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    email,
                    language,
                    returnTo
                })
            });

            const data = await response.json();

            if (!response.ok) {
                message.textContent =
                    data.message || (language === 'en'
                        ? 'Could not sign in.'
                        : 'Не удалось выполнить вход.');
                return;
            }

            window.location.href =
                data.redirect || '/gostinaya/hall';
        } catch (error) {
            message.textContent = language === 'en'
                ? 'Connection error. Please try again.'
                : 'Ошибка соединения. Попробуйте ещё раз.';
        }
    });
</script>
