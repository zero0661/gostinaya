<section class="auth-page">
  <nav class="public-nav" aria-label="Навигация / Navigation">
    <a href="/gostinaya">← Добро пожаловать / <span>Welcome</span></a>
    <a href="https://milenin.pro/">⌂ На сайт проекта / <span>Main website</span></a>
  </nav>

  <div class="auth-card">
    <h1>
      Вход<br>
      <span>Sign in</span>
    </h1>

    <p class="auth-intro">
      Укажите e-mail — мы пришлём ссылку для входа.<br>
      <span>Enter your e-mail and we will send a sign-in link.</span>
    </p>

    <form id="login-form" class="auth-form">
      <label for="email">
        E-mail
      </label>
      <input
        id="email"
        name="email"
        type="email"
        autocomplete="email"
        required
      >

      <button type="submit">
        Войти<br>
        <span>Sign in</span>
      </button>

      <p id="login-message" class="auth-message" aria-live="polite"></p>
    </form>

    <div class="auth-links">
      <p>
        Нет аккаунта? / <span>No account yet?</span>
        <a href="/gostinaya/register<%= returnTo ? `?returnTo=${encodeURIComponent(returnTo)}` : '' %>">
          Зарегистрироваться / <span>Register</span>
        </a>
      </p>
    </div>
  </div>
</section>

<script>
    const form = document.getElementById('login-form');
    const message = document.getElementById('login-message');
    const returnTo = <%- JSON.stringify(returnTo || '') %>;

    form.addEventListener('submit', async (event) => {
        event.preventDefault();

        message.textContent = 'Проверяем данные...';

        const email = document.getElementById('email').value.trim();

        try {
            const response = await fetch('/gostinaya/api/guests/login', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    email,
                    returnTo
                })
            });

            const data = await response.json();

            if (!response.ok) {
                message.textContent =
                    data.message || 'Не удалось выполнить вход.';
                return;
            }

            window.location.href =
                data.redirect || '/gostinaya/hall';
        } catch (error) {
            message.textContent =
                'Ошибка соединения. Попробуйте ещё раз.';
        }
    });



</script>
