<section class="auth-page lounge-language-page">
  <nav class="public-nav" aria-label="Navigation">
    <a href="/gostinaya" data-lang="ru">← Добро пожаловать</a>
    <a href="/gostinaya?lang=en" data-lang="en">← Welcome</a>

    <div class="language-switch" role="group" aria-label="Language">
      <button type="button" data-set-lang="ru" aria-pressed="false">RU</button>
      <span aria-hidden="true">/</span>
      <button type="button" data-set-lang="en" aria-pressed="false">EN</button>
    </div>

    <a href="https://milenin.pro/" data-lang="ru">⌂ На сайт проекта</a>
    <a href="https://milenin.pro/en/" data-lang="en">⌂ Main website</a>
  </nav>

  <div class="auth-card">
    <h1 data-lang="ru">Вход</h1>
    <h1 data-lang="en">Sign in</h1>

    <p class="auth-intro" data-lang="ru">Укажите e-mail — мы пришлём ссылку для входа.</p>
    <p class="auth-intro" data-lang="en">Enter your e-mail and we will send a sign-in link.</p>

    <form id="login-form" class="auth-form">
      <label for="email">E-mail</label>
      <input id="email" name="email" type="email" autocomplete="email" required>

      <button type="submit">
        <span data-lang="ru">Войти</span>
        <span data-lang="en">Sign in</span>
      </button>

      <p id="login-message" class="auth-message" aria-live="polite"></p>
    </form>

    <div class="auth-links">
      <p data-lang="ru">
        Нет аккаунта?
        <a href="/gostinaya/register<%= returnTo ? `?returnTo=${encodeURIComponent(returnTo)}` : '' %>">Зарегистрироваться</a>
      </p>

      <p data-lang="en">
        No account yet?
        <a href="/gostinaya/register<%= returnTo ? `?returnTo=${encodeURIComponent(returnTo)}` : '' %>">Register</a>
      </p>
    </div>
  </div>
</section>

<script>
    const form = document.getElementById('login-form');
    const message = document.getElementById('login-message');
    const returnTo = <%- JSON.stringify(returnTo || '') %>;
    const uiLanguage = () => window.getLoungeLanguage ? window.getLoungeLanguage() : (document.documentElement.dataset.loungeLang === 'en' ? 'en' : 'ru');
    const localizeMessage = (value) => window.localizeLoungeMessage ? window.localizeLoungeMessage(value, uiLanguage()) : String(value || '');
    const copy = {
      ru: {
        checking: 'Проверяем данные...',
        failed: 'Не удалось выполнить вход.',
        connection: 'Ошибка соединения. Попробуйте ещё раз.',
        emailFirst: 'Сначала укажите e-mail.',
        sending: 'Отправляем письмо...'
      },
      en: {
        checking: 'Checking your details...',
        failed: 'Could not sign in.',
        connection: 'Connection error. Please try again.',
        emailFirst: 'Enter your e-mail first.',
        sending: 'Sending the e-mail...'
      }
    };

    form.addEventListener('submit', async (event) => {
        event.preventDefault();

        const language = uiLanguage();
        message.textContent = copy[language].checking;

        const email = document.getElementById('email').value.trim();

        try {
            const response = await fetch('/gostinaya/api/guests/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email, language, returnTo })
            });

            const data = await response.json();

            if (!response.ok) {
                message.textContent = data.message ? localizeMessage(data.message) : copy[language].failed;
                return;
            }

            if (data.language === 'ru' || data.language === 'en') {
                localStorage.setItem('loungeLanguage', data.language);
                document.cookie = `loungeLanguage=${data.language}; Path=/gostinaya; Max-Age=31536000; SameSite=Lax`;
            }

            window.location.href = data.redirect || '/gostinaya/hall';
        } catch (error) {
            message.textContent = copy[language].connection;
        }
    });

</script>
