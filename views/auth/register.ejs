<section class="auth-page">
  <nav class="public-nav" aria-label="<%= lang === 'en' ? 'Navigation' : 'Навигация' %>">
    <a href="/gostinaya?lang=<%= lang %>">← <%= lang === 'en' ? 'Welcome' : 'Добро пожаловать' %></a>
    <a href="<%= lang === 'en' ? 'https://milenin.pro/en-project-map/' : 'https://milenin.pro/' %>">⌂ <%= lang === 'en' ? 'Main website' : 'На сайт проекта' %></a>
  </nav>

  <div class="auth-card">

    <p class="auth-kicker"><%= lang === 'en' ? 'The Lounge' : 'Гостиная' %></p>

    <h1><%= lang === 'en' ? 'Knock on the Door' : 'Постучать в дверь' %></h1>

    <p class="auth-intro">
      <%= lang === 'en'
        ? 'Enter your name or nickname and e-mail. We will send a sign-in link. You can change your language later inside the Lounge.'
        : 'Укажите имя или ник и e-mail. Мы пришлём ссылку для входа. Язык можно изменить позже внутри Гостиной.' %>
    </p>

    <form id="register-form" class="auth-form">

      <label for="name"><%= lang === 'en' ? 'Name or nickname' : 'Имя или ник' %></label>
      <input
        id="name"
        name="name"
        type="text"
        autocomplete="name"
        required
      >

      <label for="email">E-mail</label>
      <input
        id="email"
        name="email"
        type="email"
        autocomplete="email"
        required
      >

      <p class="auth-consent">
        <% if (lang === 'en') { %>
          By clicking Register, you accept the <a href="/gostinaya/rules" target="_blank" rel="noopener">Lounge Rules</a> and <a href="/gostinaya/privacy" target="_blank" rel="noopener">data processing terms</a>.
        <% } else { %>
          Нажимая «Зарегистрироваться», вы принимаете <a href="/gostinaya/rules" target="_blank" rel="noopener">Правила Гостиной</a> и <a href="/gostinaya/privacy" target="_blank" rel="noopener">условия обработки данных</a>.
        <% } %>
      </p>

      <button type="submit"><%= lang === 'en' ? 'Register' : 'Зарегистрироваться' %></button>

      <p id="register-message" class="auth-message" aria-live="polite"></p>
    </form>

    <div class="auth-links">
      <span><%= lang === 'en' ? 'Already have an account?' : 'Уже зарегистрированы?' %></span>

      <a href="/gostinaya/login?lang=<%= lang %><%= returnTo ? `&returnTo=${encodeURIComponent(returnTo)}` : '' %>">
        <%= lang === 'en' ? 'Sign in' : 'Войти' %>
      </a>
    </div>

  </div>
</section>

<style>
  #register-form input { font-size: 18px !important; }
  #register-form .auth-consent { font-size: 16px; line-height: 1.5; }
</style>

<script>
  const form = document.getElementById('register-form');
  const message = document.getElementById('register-message');
  const returnTo = <%- JSON.stringify(returnTo || '') %>;
  const language = <%- JSON.stringify(lang) %>;

  form.addEventListener('submit', async (event) => {
    event.preventDefault();

    const submitButton = form.querySelector('button[type="submit"]');
    submitButton.disabled = true;

    message.textContent = language === 'en'
      ? 'Creating your account...'
      : 'Создаём учётную запись...';

    const formData = new FormData(form);

    const payload = {
      name: formData.get('name'),
      email: formData.get('email'),
      language,
      returnTo
    };

    try {
      const response = await fetch('/gostinaya/api/guests/register', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(payload)
      });

      const data = await response.json();

      if (!response.ok) {
        message.textContent =
          data.error ||
          (language === 'en' ? 'Registration failed.' : 'Не удалось зарегистрироваться.');
        submitButton.disabled = false;
        return;
      }

      message.textContent = language === 'en'
        ? 'Sending the sign-in e-mail...'
        : 'Отправляем письмо для входа…';

      if (data.redirect) {
        window.location.href = data.redirect;
        return;
      }

      window.location.href = '/gostinaya/welcome';

    } catch (error) {
      message.textContent = language === 'en'
        ? 'Could not connect to the server.'
        : 'Не удалось связаться с сервером.';
      submitButton.disabled = false;
    }
  });
</script>
