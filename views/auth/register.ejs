<section class="auth-page">
  <nav class="public-nav" aria-label="Навигация / Navigation">
    <a href="/gostinaya">← Добро пожаловать / <span>Welcome</span></a>
    <a href="https://milenin.pro/">⌂ На сайт проекта / <span>Main website</span></a>
  </nav>

  <div class="auth-card">

    <p class="auth-kicker">Гостиная / The Lounge</p>

    <h1>
      Постучать в дверь<br>
      <span>Knock on the Door</span>
    </h1>

    <p class="auth-intro">
      Представьтесь и расскажите немного о себе. После регистрации мы пришлём ссылку для подтверждения e-mail.<br>
      Introduce yourself and tell us a little about yourself. We will send an e-mail confirmation link after registration.
    </p>

    <form id="register-form" class="auth-form">

      <label for="name">
        Имя<br>
        <span>Name</span>
      </label>
      <input
        id="name"
        name="name"
        type="text"
        autocomplete="name"
        required
      >

      <label for="email">E-mail</label>
      <input
        id="email"
        name="email"
        type="email"
        autocomplete="email"
        required
      >

      <label for="country">
        Страна<br>
        <span>Country</span>
      </label>
      <input id="country" name="country" type="text" autocomplete="country-name" maxlength="80" required>

      <label for="city">
        Город<br>
        <span>City</span>
      </label>
      <input id="city" name="city" type="text" autocomplete="address-level2" maxlength="80" required>

      <label for="language">
        Язык общения<br>
        <span>Language</span>
      </label>
      <select id="language" name="language" required>
        <option value="">Выберите / Select</option>
        <option value="ru">Русский / Russian</option>
        <option value="en">English / Английский</option>
      </select>

      <label for="joinReason">
        Что привело вас на сайт «После логина»?<br>
        <span>What brought you to After Login?</span>
      </label>
      <textarea id="joinReason" name="joinReason" maxlength="1000" rows="4" required></textarea>

      <label for="currentTopic">
        Какая тема вам сегодня ближе?<br>
        <span>Which topic feels closest to you today?</span>
      </label>
      <textarea id="currentTopic" name="currentTopic" maxlength="1000" rows="4" required></textarea>

      <label for="password">
        Пароль<br>
        <span>Password</span>
      </label>
      <input
        id="password"
        name="password"
        type="password"
        autocomplete="new-password"
        minlength="8"
        required
      >
<label for="confirmPassword">
  Повторите пароль<br>
  <span>Confirm password</span>
</label>
<input
  id="confirmPassword"
  name="confirmPassword"
  type="password"
  autocomplete="new-password"
  minlength="8"
  required
>
      <div class="auth-consent">
        <input id="acceptsRules" name="acceptsRules" type="checkbox" required>
        <label for="acceptsRules">
          Я принимаю <a href="/gostinaya/rules" target="_blank" rel="noopener">Правила Гостиной</a>.<br>
          <em>I accept the <a href="/gostinaya/rules" target="_blank" rel="noopener">Lounge Rules</a>.</em>
        </label>
      </div>

      <div class="auth-consent">
        <input id="acceptsPrivacy" name="acceptsPrivacy" type="checkbox" required>
        <label for="acceptsPrivacy">
          Я согласен с <a href="/gostinaya/privacy" target="_blank" rel="noopener">условиями обработки данных</a> для создания и работы аккаунта.<br>
          <em>I accept the <a href="/gostinaya/privacy" target="_blank" rel="noopener">data processing terms</a> required to create and operate my account.</em>
        </label>
      </div>

      <button type="submit">
        Зарегистрироваться<br>
        <span>Register</span>
      </button>

      <p id="register-message" class="auth-message" aria-live="polite"></p>
    </form>

    <div class="auth-links">
      <span>
        Уже зарегистрированы?<br>
        Already have an account?
      </span>

      <a href="/gostinaya/login<%= returnTo ? `?returnTo=${encodeURIComponent(returnTo)}` : '' %>">
        Войти<br>
        Sign in
      </a>
    </div>

  </div>
</section>

<style>
  /* Registration readability: keep the form geometry, enlarge only its text and consent controls. */
  #register-form input:not([type="checkbox"]),
  #register-form select,
  #register-form textarea {
    font-size: 18px !important;
  }

  #register-form .auth-consent {
    font-size: 16px !important;
    line-height: 1.5 !important;
  }

  #register-form .auth-consent input[type="checkbox"] {
    width: 18px !important;
    height: 18px !important;
    margin-top: 3px !important;
  }

  #register-form .auth-consent label {
    font-size: 16px !important;
    line-height: 1.5 !important;
  }

  #register-form .auth-consent em {
    font-size: 15px !important;
    line-height: 1.45 !important;
  }
</style>

<script>
  const form = document.getElementById('register-form');
  const message = document.getElementById('register-message');
  const returnTo = <%- JSON.stringify(returnTo || '') %>;

  form.addEventListener('submit', async (event) => {
    event.preventDefault();

    const submitButton = form.querySelector('button[type="submit"]');
    submitButton.disabled = true;

    message.textContent = 'Создаём учётную запись... / Creating your account...';

    const formData = new FormData(form);

const password = formData.get('password');
const confirmPassword = formData.get('confirmPassword');

if (password !== confirmPassword) {
  message.textContent =
    'Пароли не совпадают. / Passwords do not match.';
  submitButton.disabled = false;
  return;
}

    const payload = {
      name: formData.get('name'),
      email: formData.get('email'),
      password: formData.get('password'),
      country: formData.get('country'),
      city: formData.get('city'),
      language: formData.get('language'),
      joinReason: formData.get('joinReason'),
      currentTopic: formData.get('currentTopic'),
      returnTo,
      acceptsRules: formData.get('acceptsRules') === 'on',
      acceptsPrivacy: formData.get('acceptsPrivacy') === 'on'
    };

    try {
      const response = await fetch('/gostinaya/api/guests/register', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(payload)
      });

      const data = await response.json();

      if (!response.ok) {
        message.textContent =
          data.error ||
          'Не удалось зарегистрироваться. / Registration failed.';
        submitButton.disabled = false;
        return;
      }

      message.textContent =
        'Отправляем письмо для подтверждения… / Sending the confirmation e-mail…';

      if (data.redirect) {
        window.location.href = data.redirect;
        return;
      }

      window.location.href = '/gostinaya/welcome';

    } catch (error) {
      message.textContent =
        'Не удалось связаться с сервером. / Could not connect to the server.';
      submitButton.disabled = false;
    }
  });
</script>
