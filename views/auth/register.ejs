<section class="auth-page">
  <nav class="public-nav" aria-label="Навигация / Navigation">
    <a href="/gostinaya">← Добро пожаловать / <span>Welcome</span></a>
    <a href="https://milenin.pro/">⌂ На сайт проекта / <span>Main website</span></a>
  </nav>

  <div class="auth-card">

    <p class="auth-kicker">Гостиная / The Lounge</p>

    <h1>
      Регистрация<br>
      <span>Registration</span>
    </h1>

    <p class="auth-intro">
      Создайте учётную запись, чтобы стать участником сообщества проекта «После логина».<br>
      Create an account to join the After Login community.
    </p>

    <form id="register-form" class="auth-form">

      <label for="name">
        Имя<br>
        <span>Name</span>
      </label>
      <input
        id="name"
        name="name"
        type="text"
        autocomplete="name"
        required
      >

      <label for="email">E-mail</label>
      <input
        id="email"
        name="email"
        type="email"
        autocomplete="email"
        required
      >

      <label for="country">
        Откуда вы?<br>
        <span>Where are you from?</span>
      </label>
      <select id="country" name="country" required>
        <option value="">Выберите / Select</option>
        <option value="Russia">Россия / Russia</option>
        <option value="Germany">Германия / Germany</option>
        <option value="USA">США / USA</option>
        <option value="France">Франция / France</option>
        <option value="Netherlands">Нидерланды / Netherlands</option>
        <option value="Other">Другая страна / Other country</option>
        <option value="Prefer not to say">Не скажу / Prefer not to say</option>
      </select>

      <label for="language">
        Язык общения<br>
        <span>Language</span>
      </label>
      <select id="language" name="language" required>
        <option value="">Выберите / Select</option>
        <option value="ru">Русский / Russian</option>
        <option value="en">English / Английский</option>
      </select>

      <label for="password">
        Пароль<br>
        <span>Password</span>
      </label>
      <input
        id="password"
        name="password"
        type="password"
        autocomplete="new-password"
        minlength="8"
        required
      >
<label for="confirmPassword">
  Повторите пароль<br>
  <span>Confirm password</span>
</label>
<input
  id="confirmPassword"
  name="confirmPassword"
  type="password"
  autocomplete="new-password"
  minlength="8"
  required
>
      <button type="submit">
        Зарегистрироваться<br>
        <span>Register</span>
      </button>

      <p id="register-message" class="auth-message" aria-live="polite"></p>
    </form>

    <div class="auth-links">
      <span>
        Уже зарегистрированы?<br>
        Already have an account?
      </span>

      <a href="/gostinaya/login">
        Войти<br>
        Sign in
      </a>
    </div>

  </div>
</section>

<script>
  const form = document.getElementById('register-form');
  const message = document.getElementById('register-message');

  form.addEventListener('submit', async (event) => {
    event.preventDefault();

    message.textContent = 'Создаём учётную запись... / Creating your account...';

    const formData = new FormData(form);

const password = formData.get('password');
const confirmPassword = formData.get('confirmPassword');

if (password !== confirmPassword) {
  message.textContent =
    'Пароли не совпадают. / Passwords do not match.';
  return;
}

    const payload = {
      name: formData.get('name'),
      email: formData.get('email'),
      password: formData.get('password'),
      country: formData.get('country'),
      language: formData.get('language')
    };

    try {
      const response = await fetch('/gostinaya/api/guests/register', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(payload)
      });

      const data = await response.json();

      if (!response.ok) {
        message.textContent =
          data.error ||
          'Не удалось зарегистрироваться. / Registration failed.';
        return;
      }

      if (data.message === 'Guest already exists') {
        message.textContent =
          'Этот e-mail уже зарегистрирован. / This e-mail is already registered.';
        return;
      }

      message.textContent =
        'Регистрация завершена. Добро пожаловать! / Registration complete. Welcome!';

      if (data.redirect) {
        window.location.href = data.redirect;
        return;
      }

      window.location.href = '/gostinaya/hall';

    } catch (error) {
      message.textContent =
        'Не удалось связаться с сервером. / Could not connect to the server.';
    }
  });
</script>
