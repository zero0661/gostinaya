<section class="auth-page">
  <nav class="public-nav" aria-label="Навигация / Navigation">
    <a href="/gostinaya">← Добро пожаловать / <span>Welcome</span></a>
    <a href="https://milenin.pro/">⌂ На сайт проекта / <span>Main website</span></a>
  </nav>

  <div class="auth-card">

    <p class="auth-kicker">Гостиная / The Lounge</p>

    <h1>
      Постучать в дверь<br>
      <span>Knock on the Door</span>
    </h1>

    <p class="auth-intro">
      Укажите имя или ник и e-mail. Мы пришлём ссылку для входа. Язык можно выбрать внутри Гостиной.<br>
      Enter your name or nickname and e-mail. We will send a sign-in link. You can choose your language inside the Lounge.
    </p>

    <form id="register-form" class="auth-form">

      <label for="name">
        Имя или ник<br>
        <span>Name or nickname</span>
      </label>
      <input
        id="name"
        name="name"
        type="text"
        autocomplete="name"
        required
      >

      <label for="email">E-mail</label>
      <input
        id="email"
        name="email"
        type="email"
        autocomplete="email"
        required
      >

      <p class="auth-consent">
        Нажимая «Зарегистрироваться», вы принимаете <a href="/gostinaya/rules" target="_blank" rel="noopener">Правила Гостиной</a> и <a href="/gostinaya/privacy" target="_blank" rel="noopener">условия обработки данных</a>.<br>
        By clicking Register, you accept the Lounge Rules and data processing terms linked above.
      </p>

      <button type="submit">
        Зарегистрироваться<br>
        <span>Register</span>
      </button>

      <p id="register-message" class="auth-message" aria-live="polite"></p>
    </form>

    <div class="auth-links">
      <span>
        Уже зарегистрированы?<br>
        Already have an account?
      </span>

      <a href="/gostinaya/login<%= returnTo ? `?returnTo=${encodeURIComponent(returnTo)}` : '' %>">
        Войти<br>
        Sign in
      </a>
    </div>

  </div>
</section>

<style>
  #register-form input { font-size: 18px !important; }
  #register-form .auth-consent { font-size: 16px; line-height: 1.5; }
</style>

<script>
  const form = document.getElementById('register-form');
  const message = document.getElementById('register-message');
  const returnTo = <%- JSON.stringify(returnTo || '') %>;

  form.addEventListener('submit', async (event) => {
    event.preventDefault();

    const submitButton = form.querySelector('button[type="submit"]');
    submitButton.disabled = true;

    message.textContent = 'Создаём учётную запись... / Creating your account...';

    const formData = new FormData(form);

    const payload = {
      name: formData.get('name'),
      email: formData.get('email'),
      returnTo
    };

    try {
      const response = await fetch('/gostinaya/api/guests/register', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(payload)
      });

      const data = await response.json();

      if (!response.ok) {
        message.textContent =
          data.error ||
          'Не удалось зарегистрироваться. / Registration failed.';
        submitButton.disabled = false;
        return;
      }

      message.textContent =
        'Отправляем письмо для подтверждения… / Sending the confirmation e-mail…';

      if (data.redirect) {
        window.location.href = data.redirect;
        return;
      }

      window.location.href = '/gostinaya/welcome';

    } catch (error) {
      message.textContent =
        'Не удалось связаться с сервером. / Could not connect to the server.';
      submitButton.disabled = false;
    }
  });
</script>
