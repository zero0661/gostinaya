<section class="auth-page">
  <nav class="public-nav" aria-label="Навигация / Navigation">
    <a href="/gostinaya">← Добро пожаловать / <span>Welcome</span></a>
    <a href="https://milenin.pro/">⌂ На сайт проекта / <span>Main website</span></a>
  </nav>

  <div class="auth-card">

    <p class="auth-kicker">Гостиная / The Lounge</p>

    <h1>
      Постучать в дверь<br>
      <span>Knock on the Door</span>
    </h1>

    <p class="auth-intro">
      Представьтесь и расскажите немного о себе. Доступ откроется сразу после регистрации.<br>
      Introduce yourself and tell us a little about yourself. Access opens immediately after registration.
    </p>

    <form id="register-form" class="auth-form">

      <label for="name">
        Имя<br>
        <span>Name</span>
      </label>
      <input
        id="name"
        name="name"
        type="text"
        autocomplete="name"
        required
      >

      <label for="email">E-mail</label>
      <input
        id="email"
        name="email"
        type="email"
        autocomplete="email"
        required
      >

      <label for="country">
        Страна<br>
        <span>Country</span>
      </label>
      <input id="country" name="country" type="text" autocomplete="country-name" maxlength="80" required>

      <label for="city">
        Город<br>
        <span>City</span>
      </label>
      <input id="city" name="city" type="text" autocomplete="address-level2" maxlength="80" required>

      <label for="language">
        Язык общения<br>
        <span>Language</span>
      </label>
      <select id="language" name="language" required>
        <option value="">Выберите / Select</option>
        <option value="ru">Русский / Russian</option>
        <option value="en">English / Английский</option>
      </select>

      <label for="joinReason">
        Что привело вас на сайт «После логина»?<br>
        <span>What brought you to After Login?</span>
      </label>
      <textarea id="joinReason" name="joinReason" maxlength="1000" rows="4" required></textarea>

      <label for="currentTopic">
        Какая тема вам сегодня ближе?<br>
        <span>Which topic feels closest to you today?</span>
      </label>
      <textarea id="currentTopic" name="currentTopic" maxlength="1000" rows="4" required></textarea>

      <label for="password">
        Пароль<br>
        <span>Password</span>
      </label>
      <input
        id="password"
        name="password"
        type="password"
        autocomplete="new-password"
        minlength="8"
        required
      >
<label for="confirmPassword">
  Повторите пароль<br>
  <span>Confirm password</span>
</label>
<input
  id="confirmPassword"
  name="confirmPassword"
  type="password"
  autocomplete="new-password"
  minlength="8"
  required
>
      <label class="auth-consent" for="acceptsRules">
        <input id="acceptsRules" name="acceptsRules" type="checkbox" required>
        <span>
          Я принимаю Правила Гостиной.<br>
          <em>I accept the Lounge Rules.</em>
        </span>
      </label>

      <label class="auth-consent" for="acceptsPrivacy">
        <input id="acceptsPrivacy" name="acceptsPrivacy" type="checkbox" required>
        <span>
          Я согласен на обработку указанных данных для создания и работы аккаунта.<br>
          <em>I consent to the processing of the submitted data to create and operate my account.</em>
        </span>
      </label>

      <button type="submit">
        Зарегистрироваться<br>
        <span>Register</span>
      </button>

      <p id="register-message" class="auth-message" aria-live="polite"></p>
    </form>

    <div class="auth-links">
      <span>
        Уже зарегистрированы?<br>
        Already have an account?
      </span>

      <a href="/gostinaya/login">
        Войти<br>
        Sign in
      </a>
    </div>

  </div>
</section>

<script>
  const form = document.getElementById('register-form');
  const message = document.getElementById('register-message');

  form.addEventListener('submit', async (event) => {
    event.preventDefault();

    message.textContent = 'Создаём учётную запись... / Creating your account...';

    const formData = new FormData(form);

const password = formData.get('password');
const confirmPassword = formData.get('confirmPassword');

if (password !== confirmPassword) {
  message.textContent =
    'Пароли не совпадают. / Passwords do not match.';
  return;
}

    const payload = {
      name: formData.get('name'),
      email: formData.get('email'),
      password: formData.get('password'),
      country: formData.get('country'),
      city: formData.get('city'),
      language: formData.get('language'),
      joinReason: formData.get('joinReason'),
      currentTopic: formData.get('currentTopic'),
      acceptsRules: formData.get('acceptsRules') === 'on',
      acceptsPrivacy: formData.get('acceptsPrivacy') === 'on'
    };

    try {
      const response = await fetch('/gostinaya/api/guests/register', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(payload)
      });

      const data = await response.json();

      if (!response.ok) {
        message.textContent =
          data.error ||
          'Не удалось зарегистрироваться. / Registration failed.';
        return;
      }

      message.textContent =
        'Регистрация завершена. Добро пожаловать! / Registration complete. Welcome!';

      if (data.redirect) {
        window.location.href = data.redirect;
        return;
      }

      window.location.href = '/gostinaya/welcome';

    } catch (error) {
      message.textContent =
        'Не удалось связаться с сервером. / Could not connect to the server.';
    }
  });
</script>
