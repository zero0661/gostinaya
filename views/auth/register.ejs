<section class="auth-page lounge-language-page">
  <nav class="public-nav" aria-label="Navigation">
    <a href="/gostinaya" data-lang="ru">← Добро пожаловать</a>
    <a href="/gostinaya?lang=en" data-lang="en">← Welcome</a>

    <div class="language-switch" role="group" aria-label="Language">
      <button type="button" data-set-lang="ru" aria-pressed="false">RU</button>
      <span aria-hidden="true">/</span>
      <button type="button" data-set-lang="en" aria-pressed="false">EN</button>
    </div>

    <a href="https://milenin.pro/" data-lang="ru">⌂ На сайт проекта</a>
    <a href="https://milenin.pro/en/" data-lang="en">⌂ Main website</a>
  </nav>

  <div class="auth-card">
    <h1 data-lang="ru">Постучать в дверь</h1>
    <h1 data-lang="en">Knock on the Door</h1>

    <p class="auth-intro" data-lang="ru">
      Укажите имя или ник и e-mail. Мы пришлём ссылку для входа. Язык можно выбрать внутри Гостиной.
    </p>
    <p class="auth-intro" data-lang="en">
      Enter your name or nickname and e-mail. We will send a sign-in link. You can choose your language inside the Lounge.
    </p>

    <form id="register-form" class="auth-form">
      <label for="name" data-lang="ru">Имя или ник</label>
      <label for="name" data-lang="en">Name or nickname</label>
      <input id="name" name="name" type="text" autocomplete="name" required>

      <label for="email">E-mail</label>
      <input id="email" name="email" type="email" autocomplete="email" required>

      <p class="auth-consent" data-lang="ru">Нажимая «Зарегистрироваться», вы принимаете <a href="/gostinaya/rules" target="_blank" rel="noopener">Правила Гостиной</a> и <a href="/gostinaya/privacy" target="_blank" rel="noopener">условия обработки данных</a>.</p>
      <p class="auth-consent" data-lang="en">By clicking Register, you accept the <a href="/gostinaya/rules?lang=en" target="_blank" rel="noopener">Lounge Rules</a> and <a href="/gostinaya/privacy?lang=en" target="_blank" rel="noopener">data processing terms</a>.</p>

      <button type="submit">
        <span data-lang="ru">Зарегистрироваться</span>
        <span data-lang="en">Register</span>
      </button>

      <p id="register-message" class="auth-message" aria-live="polite"></p>
    </form>

    <div class="auth-links">
      <p data-lang="ru">Уже зарегистрированы? <a href="/gostinaya/login<%= returnTo ? `?returnTo=${encodeURIComponent(returnTo)}` : '' %>">Войти</a></p>
      <p data-lang="en">Already have an account? <a href="/gostinaya/login<%= returnTo ? `?returnTo=${encodeURIComponent(returnTo)}` : '' %>">Sign in</a></p>
    </div>
  </div>
</section>

<style>
  #register-form input { font-size: 18px !important; }
  #register-form .auth-consent { font-size: 16px; line-height: 1.5; }
</style>

<script>
  const form = document.getElementById('register-form');
  const message = document.getElementById('register-message');
  const returnTo = <%- JSON.stringify(returnTo || '') %>;
  const uiLanguage = () => window.getLoungeLanguage ? window.getLoungeLanguage() : (document.documentElement.dataset.loungeLang === 'en' ? 'en' : 'ru');
  const localizeMessage = (value, language) => window.localizeLoungeMessage ? window.localizeLoungeMessage(value, language) : String(value || '');
  const copy = {
    ru: {
      creating: 'Создаём учётную запись...',
      failed: 'Не удалось зарегистрироваться.',
      sending: 'Отправляем письмо для подтверждения…',
      connection: 'Не удалось связаться с сервером.'
    },
    en: {
      creating: 'Creating your account...',
      failed: 'Registration failed.',
      sending: 'Sending the confirmation e-mail…',
      connection: 'Could not connect to the server.'
    }
  };

  form.addEventListener('submit', async (event) => {
    event.preventDefault();

    const language = uiLanguage();
    const submitButton = form.querySelector('button[type="submit"]');
    submitButton.disabled = true;
    message.textContent = copy[language].creating;

    const formData = new FormData(form);
    const payload = {
      name: formData.get('name'),
      email: formData.get('email'),
      language,
      returnTo
    };

    try {
      const response = await fetch('/gostinaya/api/guests/register', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify(payload)
      });

      const data = await response.json();

      if (!response.ok) {
        message.textContent = data.error ? localizeMessage(data.error, language) : copy[language].failed;
        submitButton.disabled = false;
        return;
      }

      message.textContent = copy[language].sending;

      if (data.redirect) {
        window.location.href = data.redirect;
        return;
      }

      window.location.href = '/gostinaya/welcome';
    } catch (error) {
      message.textContent = copy[language].connection;
      submitButton.disabled = false;
    }
  });
</script>
