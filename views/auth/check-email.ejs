<section class="auth-page lounge-language-page">
  <nav class="public-nav" aria-label="Language-aware navigation">
    <a href="/gostinaya">
      <span data-lang="ru">← Добро пожаловать</span>
      <span data-lang="en">← Welcome</span>
    </a>
    <a href="https://milenin.pro/">
      <span data-lang="ru">⌂ На сайт проекта</span>
      <span data-lang="en">⌂ Main website</span>
    </a>
  </nav>

  <div class="auth-card public-welcome registration-welcome">
    <div data-lang="ru">
      <h1>Проверьте почту</h1>
      <p class="auth-intro">Мы отправили ссылку для подтверждения<%= email ? ` на ${email}` : '' %>.</p>
      <p>Перейдите по ссылке в письме в течение 24 часов. Только после этого откроется вход в Гостиную.</p>
      <p class="auth-hint">Если письма нет несколько минут, проверьте папку «Спам» и правильность адреса.</p>
    </div>

    <div data-lang="en">
      <h1>Check your inbox</h1>
      <p class="auth-intro">We sent an e-mail confirmation link<%= email ? ` to ${email}` : '' %>.</p>
      <p>Follow the link within 24 hours. The Lounge will open only after confirmation.</p>
      <p class="auth-hint">If the message does not arrive within a few minutes, check Spam and the address you entered.</p>
    </div>

    <% if (email) { %>
      <form id="resend-verification-form" class="auth-form auth-resend-form">
        <input type="hidden" name="email" value="<%= email %>">
        <button type="submit">
          <span data-lang="ru">Отправить письмо ещё раз</span>
          <span data-lang="en">Send the message again</span>
        </button>
        <p id="resend-verification-message" class="auth-message" aria-live="polite"></p>
      </form>
    <% } %>

    <div class="welcome-actions">
      <a class="welcome-secondary" href="/gostinaya/login">
        <span data-lang="ru">Перейти ко входу</span>
        <span data-lang="en">Go to sign in</span>
      </a>
    </div>
  </div>
</section>

<% if (email) { %>
<script>
let verificationCheckInProgress = false;
const currentLang = () => window.getLoungeLanguage ? window.getLoungeLanguage() : (document.documentElement.dataset.loungeLang === 'en' ? 'en' : 'ru');
const localizeMessage = (value) => window.localizeLoungeMessage ? window.localizeLoungeMessage(value, currentLang()) : String(value || '');

async function checkVerificationStatus() {
  if (verificationCheckInProgress) return;
  verificationCheckInProgress = true;

  try {
    const response = await fetch('/gostinaya/api/session-status', {
      cache: 'no-store',
      credentials: 'same-origin'
    });
    const data = await response.json();

    if (data.authenticated) {
      window.location.replace('/gostinaya/welcome');
    }
  } catch {
    // A temporary network failure should not interrupt the waiting page.
  } finally {
    verificationCheckInProgress = false;
  }
}

checkVerificationStatus();
window.setInterval(checkVerificationStatus, 2500);
document.addEventListener('visibilitychange', () => {
  if (!document.hidden) checkVerificationStatus();
});

document.getElementById('resend-verification-form').addEventListener('submit', async (event) => {
  event.preventDefault();
  const form = event.currentTarget;
  const button = form.querySelector('button');
  const message = document.getElementById('resend-verification-message');
  button.disabled = true;
  message.textContent = currentLang() === 'en' ? 'Sending…' : 'Отправляем…';

  try {
    const response = await fetch('/gostinaya/api/guests/resend-verification', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: form.elements.email.value })
    });
    const data = await response.json();
    message.textContent = localizeMessage(data.message);
  } catch {
    message.textContent = currentLang() === 'en' ? 'Connection error.' : 'Ошибка соединения.';
  } finally {
    window.setTimeout(() => { button.disabled = false; }, 60000);
  }
});
</script>
<% } %>
