<section class="auth-page">
  <nav class="public-nav" aria-label="<%= lang === 'en' ? 'Navigation' : 'Навигация' %>">
    <a href="/gostinaya?lang=<%= lang %>">← <%= lang === 'en' ? 'Welcome' : 'Добро пожаловать' %></a>
    <a href="<%= lang === 'en' ? 'https://milenin.pro/en-project-map/' : 'https://milenin.pro/' %>">⌂ <%= lang === 'en' ? 'Main website' : 'На сайт проекта' %></a>
  </nav>

  <div class="auth-card public-welcome registration-welcome">
    <p class="auth-kicker"><%= lang === 'en' ? 'The Lounge' : 'Гостиная' %></p>
    <h1><%= lang === 'en' ? 'Check your inbox' : 'Проверьте почту' %></h1>

    <p class="auth-intro">
      <% if (lang === 'en') { %>
        If the account is available, a sign-in link has been sent<%= email ? ` to ${email}` : '' %>.
      <% } else { %>
        Если аккаунт доступен, ссылка для входа отправлена<%= email ? ` на ${email}` : '' %>.
      <% } %>
    </p>

    <p>
      <%= lang === 'en'
        ? 'Follow the link within 24 hours. The Lounge will open after you use it.'
        : 'Перейдите по ссылке в письме в течение 24 часов. После этого откроется вход в Гостиную.' %>
    </p>

    <p class="auth-hint">
      <%= lang === 'en'
        ? 'If the message does not arrive within a few minutes, check Spam and the address you entered.'
        : 'Если письма нет несколько минут, проверьте папку «Спам» и правильность адреса.' %>
    </p>

    <% if (email) { %>
      <form id="resend-verification-form" class="auth-form auth-resend-form">
        <input type="hidden" name="email" value="<%= email %>">
        <button type="submit"><%= lang === 'en' ? 'Send the message again' : 'Отправить письмо ещё раз' %></button>
        <p id="resend-verification-message" class="auth-message" aria-live="polite"></p>
      </form>
    <% } %>

    <div class="welcome-actions">
      <a class="welcome-secondary" href="/gostinaya/login?lang=<%= lang %>">
        <%= lang === 'en' ? 'Go to sign in' : 'Перейти ко входу' %>
      </a>
    </div>
  </div>
</section>

<% if (email) { %>
<script>
let verificationCheckInProgress = false;
const language = <%- JSON.stringify(lang) %>;

async function checkVerificationStatus() {
  if (verificationCheckInProgress) return;
  verificationCheckInProgress = true;

  try {
    const response = await fetch('/gostinaya/api/session-status', {
      cache: 'no-store',
      credentials: 'same-origin'
    });
    const data = await response.json();

    if (data.authenticated) {
      window.location.replace('/gostinaya/welcome');
    }
  } catch {
    // A temporary network failure should not interrupt the waiting page.
  } finally {
    verificationCheckInProgress = false;
  }
}

checkVerificationStatus();
window.setInterval(checkVerificationStatus, 2500);
document.addEventListener('visibilitychange', () => {
  if (!document.hidden) checkVerificationStatus();
});

document.getElementById('resend-verification-form').addEventListener('submit', async (event) => {
  event.preventDefault();
  const form = event.currentTarget;
  const button = form.querySelector('button');
  const message = document.getElementById('resend-verification-message');
  button.disabled = true;
  message.textContent = language === 'en' ? 'Sending…' : 'Отправляем…';

  try {
    const response = await fetch('/gostinaya/api/guests/resend-verification', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: form.elements.email.value })
    });
    const data = await response.json();
    message.textContent = data.message;
  } catch {
    message.textContent = language === 'en' ? 'Connection error.' : 'Ошибка соединения.';
  } finally {
    window.setTimeout(() => { button.disabled = false; }, 60000);
  }
});
</script>
<% } %>
